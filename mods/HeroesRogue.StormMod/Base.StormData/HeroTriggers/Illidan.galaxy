include "AffixTriggers"

int libAffx_IllidanTalentTier16Counter;
int[8] libAffx_IllidanTalents;

int libAffx_WheresIllidanIndex;

// ---------------------------------------------------------------
// Illidan - Add an empty talent when all level 16 talents are unavailable
// ---------------------------------------------------------------
bool libAffx_IllidanTalent16 (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_IllidanTalents[6] += 1;
    if (libAffx_IllidanTalents[6] == 3) {
        libAffx_ShowTalent("DoNothing16", true);
    }
    return true;
}
// ---------------------------------------------------------------
// Illidan Evasive
// ---------------------------------------------------------------
bool libAffx_IllidanEvasiveUnitCreated (bool testConds, bool runActions) {
    int player = UnitGetOwner(EventUnitCreatedUnit());
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_AddPlayerBehavior(libAffx_player, "IllidanEvasion", 1, true);
    libAffx_AddPlayerBehavior(libAffx_player, "IllidanEvasionSpellArmor", 1, true);
    return true;
}
// ---------------------------------------------------------------
// Legally Blind
// ---------------------------------------------------------------
bool libAffx_IllidanLegallyBlindBehaviorChangeCategory (bool testConds, bool runActions) {
    unit unitVar = EventUnit();
    string behavior = EventUnitBehavior();
    fixed behaviorDuration;
    fixed newDuration;
    fixed percentIncrease;
    if (testConds) {
        if (UnitGetOwner(unitVar) != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    UnitBehaviorRemove(unitVar, behavior, 1);
    if ((behaviorDuration > 0.0)) {
        UnitBehaviorSetDuration(unitVar, behavior, 0);
    }
    
    return true;
}
// ---------------------------------------------------------------
// Wheres Illidan
// ---------------------------------------------------------------
bool libAffx_WheresIllidanAffixAdded (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libAffx_WheresIllidanIndex = libAffx_EventAffix();
    libAffx_affixes[libAffx_WheresIllidanIndex].cooldown = RandomInt(50, 250);
    return true;
}
bool libAffx_WheresIllidanPeriodic (bool testConds, bool runActions) {
    unit maiev;
    if (testConds) {
        if (libAffx_gamePaused) {
            return false;
        }
        if (libAffx_WheresIllidanIndex == 0) {
            return false;
        }
        if (!libAffx_GateIsOpen()) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    if (libAffx_affixes[libAffx_WheresIllidanIndex].cooldown <= 0 && UnitIsAlive(libGame_gv_players[libAffx_player].lv_heroUnit)) {
        libAffx_affixes[libAffx_WheresIllidanIndex].cooldown = RandomInt(50, 250);
        libNtve_gf_SendActorMessageToUnit(libGame_gv_players[libAffx_player].lv_heroUnit, "Create MaievWheresIllidanWarningVO");
        libAffx_Wait(2.5, c_timeGame);
        libNtve_gf_CreateUnitsAtPoint2(1, "HeroMaiev", c_unitCreateIgnorePlacement, libAffx_teamChaos, PointWithOffsetPolar(UnitGetPosition(libGame_gv_players[libAffx_player].lv_heroUnit), 14, RandomFixed(0, 360)), null);
        maiev = UnitLastCreated();
        UnitBehaviorAdd(maiev, "Affix60MoveSpeed", maiev, 1);
        libNtve_gf_SendActorMessageToUnit(maiev, "Signal Respawn");
        UnitIssueOrder(maiev, OrderTargetingPoint(AbilityCommand("move", 0), UnitGetPosition(libGame_gv_players[libAffx_player].lv_heroUnit)), c_orderQueueReplace);
        libAffx_Wait(0.825, c_timeGame);
        if (UnitIsAlive(maiev)) {
            UnitCreateEffectPoint(maiev, "MaievContainmentDiscLaunchMissile", UnitGetPosition(libGame_gv_players[libAffx_player].lv_heroUnit));
        }
        libAffx_Wait(0.75, c_timeGame);
        UnitRemove(maiev);
        UnitKill(maiev);
        
    } else {
        libAffx_affixes[libAffx_WheresIllidanIndex].cooldown -= 0.0625;
    }
    
    return true;
}