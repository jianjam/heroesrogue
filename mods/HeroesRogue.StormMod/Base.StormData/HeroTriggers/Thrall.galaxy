include "AffixTriggers"

// ============================================================
// Lightning Rod
// ============================================================
bool libAffx_ThrallLightningRodExecuteOncePerGame (bool testConds, bool runActions) {
    libAffx_AffixSetHero(libAffx_GetAffixId("NexusRange"), "Thrall", true);
    return true;
}
// ============================================================
// Quests Galore
// ============================================================
bool libAffx_ThrallQuestsGaloreExecuteOncePerGame (bool testConds, bool runActions) {
    TalentTreeSetSelectedHeroTalent(libAffx_player, 4, 1);
    libGame_gf_TalentsUpdateChoicePanelForPlayer(libAffx_player);
    return true;
}