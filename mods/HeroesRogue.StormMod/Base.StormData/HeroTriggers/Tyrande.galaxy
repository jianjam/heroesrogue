include "AffixTriggers"

unit libAffx_NightElfBondMalfurion;
unit libAffx_NightElfBondTyrande;

// ============================================================
// Night Elf Bond
// ============================================================
void libAffx_TyrandeNightElfBondSpawnMalfurion () {
    fixed sharedHealth;
    if (libAffx_NightElfBondMalfurion == null || !UnitIsAlive(libAffx_NightElfBondMalfurion)) {
        libNtve_gf_CreateUnitsAtPoint2(1, "HeroMalfurion", c_unitCreateIgnorePlacement, libAffx_teamOrder, PointWithOffsetPolar(UnitGetPosition(libGame_gv_players[libAffx_player].lv_heroUnit), 5, RandomFixed(0, 360)), null);
        libAffx_NightElfBondMalfurion = UnitLastCreated();
        libAffx_NightElfBondTyrande = libAffx_GetPlayerHeroUnit(libAffx_player);
        libNtve_gf_SendActorMessageToUnit(libAffx_NightElfBondMalfurion, "Signal Respawn");
        UnitCreateEffectUnit(libGame_gv_players[libAffx_player].lv_heroUnit, "ApplyNightElfBondMalfurion", libAffx_NightElfBondMalfurion);
        sharedHealth = (UnitGetPropertyFixed(libAffx_NightElfBondTyrande, c_unitPropLife, true) + UnitGetPropertyFixed(libAffx_NightElfBondMalfurion, c_unitPropLife, true) / 2);
        UnitSetPropertyFixed(libAffx_NightElfBondTyrande, c_unitPropLife, sharedHealth);
        UnitSetPropertyFixed(libAffx_NightElfBondMalfurion, c_unitPropLife, sharedHealth);
    }
}
bool libAffx_TyrandeNightElfBondDamageTaken (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    int player = UnitGetOwner(eventUnit);
    fixed incomingDamage = EventUnitDamageAmount();
    if (testConds) {
        if (eventUnit != libAffx_NightElfBondMalfurion && eventUnit != libAffx_NightElfBondTyrande) {
            return false;
        }
        if (libAffx_NightElfBondMalfurion == null || libAffx_NightElfBondTyrande == null) {
            return false;
        }
    }
    if (eventUnit == libAffx_NightElfBondTyrande) {
        //UnitSetPropertyFixed(libAffx_NightElfBondTyrande, c_unitPropLife, UnitGetPropertyFixed(libAffx_NightElfBondTyrande, c_unitPropLife, true) + incomingDamage / 2);
        UnitSetPropertyFixed(libAffx_NightElfBondMalfurion, c_unitPropLife, UnitGetPropertyFixed(libAffx_NightElfBondTyrande, c_unitPropLife, true));
    } else {
        //UnitSetPropertyFixed(libAffx_NightElfBondMalfurion, c_unitPropLife, UnitGetPropertyFixed(libAffx_NightElfBondMalfurion, c_unitPropLife, true) + incomingDamage / 2);
        UnitSetPropertyFixed(libAffx_NightElfBondTyrande, c_unitPropLife, UnitGetPropertyFixed(libAffx_NightElfBondMalfurion, c_unitPropLife, true));
    }
    return true;
}
bool libAffx_TyrandeNightElfBondHealed (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    int player = UnitGetOwner(eventUnit);
    fixed healingReceived = EventUnitHealAmount();
    if (testConds) {
        if (eventUnit != libAffx_NightElfBondMalfurion && eventUnit != libAffx_NightElfBondTyrande) {
            return false;
        }
        if (libAffx_NightElfBondMalfurion == null || libAffx_NightElfBondTyrande == null) {
            return false;
        }
    }
    if (eventUnit == libAffx_NightElfBondTyrande) {
        //UnitSetPropertyFixed(libAffx_NightElfBondTyrande, c_unitPropLife, UnitGetPropertyFixed(libAffx_NightElfBondTyrande, c_unitPropLife, true) - healingReceived / 2);
        UnitSetPropertyFixed(libAffx_NightElfBondMalfurion, c_unitPropLife, UnitGetPropertyFixed(libAffx_NightElfBondTyrande, c_unitPropLife, true));
    } else {
        //UnitSetPropertyFixed(libAffx_NightElfBondMalfurion, c_unitPropLife, UnitGetPropertyFixed(libAffx_NightElfBondMalfurion, c_unitPropLife, true) - healingReceived / 2);
        UnitSetPropertyFixed(libAffx_NightElfBondTyrande, c_unitPropLife, UnitGetPropertyFixed(libAffx_NightElfBondMalfurion, c_unitPropLife, true));
    }
    return true;
}
bool libAffx_TyrandeNightElfBondOncePerGame (bool testConds, bool runActions) {
    trigger damageEvent = TriggerCreate("libAffx_TyrandeNightElfBondDamageTaken");
    trigger healEvent = TriggerCreate("libAffx_TyrandeNightElfBondHealed");
    libGame_AddAbilityEffectMapping("TyrandeNightElfBond", "NightElfBondDamage");

    TriggerAddDamageEvent(damageEvent, null, "HeroTyrande", c_unitDamageTypeAny, c_unitDamageEither, null);
    TriggerAddDamageEvent(damageEvent, null, "HeroMalfurion", c_unitDamageTypeAny, c_unitDamageEither, null);
    TriggerAddEventUnitHealed(healEvent, null, c_unitVitalLife, null);
    return true;
}
bool libAffx_TyrandeNightElfBondAffixAdded (bool testConds, bool runActions) {
    libAffx_TyrandeNightElfBondSpawnMalfurion();
    return true;
}
bool libAffx_TyrandeNightElfBondRespawn (bool testConds, bool runActions) {
    int player = libGame_gf_HeroRespawnPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_TyrandeNightElfBondSpawnMalfurion();

    return true;
}
bool libAffx_TyrandeNightElfBondUnitDied (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    int deadPlayer = EventPlayer();
    if (testConds) {
        if (deadPlayer != libAffx_player && deadUnit != libAffx_NightElfBondMalfurion) {
            return false;
        }
    }
    if (deadPlayer == libAffx_player) {
        UnitKill(libAffx_NightElfBondMalfurion);
        UnitRemove(libAffx_NightElfBondMalfurion);
    } else if (deadUnit == libAffx_NightElfBondMalfurion) {
        UnitCreateEffectUnit(libGame_gv_players[libAffx_player].lv_heroUnit, "NightElfBondDamage", libGame_gv_players[libAffx_player].lv_heroUnit);
    }

    return true;
}
bool libAffx_TyrandeNightElfBondPeriodic (bool testConds, bool runActions) {
    if (testConds) {
        if (!UnitIsAlive(libAffx_NightElfBondMalfurion)) {
            return false;
        }
        if (libAffx_gamePaused || libGame_gv_gameOver) {
            return false;
        }
    }
    if ((DistanceBetweenPoints(UnitGetPosition(libAffx_NightElfBondMalfurion), UnitGetPosition(libAffx_NightElfBondTyrande)) >= 24)) {
        UnitSetPosition(libAffx_NightElfBondMalfurion, PointWithOffsetPolar(UnitGetPosition(libAffx_NightElfBondTyrande), 1.5, RandomFixed(0, 360)), false);
        UnitIssueOrder(libAffx_NightElfBondMalfurion, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    }

    if (UnitGetPropertyFixed(libAffx_NightElfBondMalfurion, c_unitPropLifeMax, true) != UnitGetPropertyFixed(libAffx_NightElfBondTyrande, c_unitPropLifeMax, true)) {
        UnitSetPropertyFixed(libAffx_NightElfBondMalfurion, c_unitPropLifeMax, UnitGetPropertyFixed(libAffx_NightElfBondTyrande, c_unitPropLifeMax, true));
    }

    return true;
}

// ============================================================
// Flyby Attack
// ============================================================
bool libAffx_TyrandeFlybyAttackScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,SentinelShotDamagePvE,Amount", player);

    return true;
}
bool libAffx_TyrandeFlybyAttackAffixAdded (bool testConds, bool runActions) {
    if (PlayerHasTalent(libAffx_player, "TyrandeRanger")) {
        libAffx_CatalogReferenceModify("Effect,SentinelShotMissileSearchPvE,AreaArray[0].RectangleWidth", libAffx_player, "1.25", c_upgradeOperationAdd);
    }
    return true;
}
bool libAffx_TyrandeFlybyAttackEffectUsed (bool testConds, bool runActions) {
    unit caster =  EventPlayerEffectUsedUnit(c_effectUnitCaster);
    point casterPoint = EventPlayerEffectUsedPoint(c_effectLocationTargetPoint);
    int player = UnitGetOwner(caster);
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    UnitCreateEffectPoint(caster, "SentinelShotMissileSearchPvE", casterPoint);
    return true;
}
bool libAffx_TyrandeFlybyAttackTalentGained (bool testConds, bool runActions) {
    int player = libGame_gf_HeroGainTalentPlayer();
    string talent = libGame_gf_HeroGainTalentGainedTalent();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
        if (talent != "TyrandeRanger") {
            return false;
        }
    }
    libAffx_CatalogReferenceModify("Effect,SentinelShotMissileSearchPvE,AreaArray[0].RectangleWidth", libAffx_player, "1.25", c_upgradeOperationAdd);

    return true;
}

// ============================================================
// Shadowstalker
// ============================================================

bool libAffx_TyrandeShadowstalkerEffectUsed (bool testConds, bool runActions) {
    unit caster = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    int player = UnitGetOwner(caster);
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_UnitCreateEffectUnitToAllFilter(caster, "TyrandeShadowstalkApplyHealingBehavior", libAffx_filterAlliedMinions);
    return true;
}

// ============================================================
// Elune's Wrath
// ============================================================
bool libAffx_TyrandeElunesWrathScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,LightofEluneDamageTarget,Amount", player);

    return true;
}