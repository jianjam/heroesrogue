include "AffixTriggers"

bool libAffx_AnaPoisonDartScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,AnaPoisonDartDamage,Amount", player);

    return true;
}