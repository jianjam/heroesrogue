include "AffixTriggers"

int libAffx_PylonExpansionAmount;
int libAffx_ProbiusZealotCost = 5;
int libAffx_ProbiusStalkerCost = 10;
int libAffx_ProbiusImmortalCost = 30;

int libAffx_ProbiusTurboDurationIncrease;

// ============================================================
// Warp Technology
// ============================================================
bool libAffx_ProbiusWarpTechnologyScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }

    libAffx_SetDefaultLevelScaling("Effect,PsiBlades,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,ParticleDisruptorsU,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,PhaseDisruptors,Amount", player);
    libAffx_SetDefaultLevelScaling("Behavior,ImmortalHardenedShield,DamageResponse.ClampMaximum", player);
    libAffx_SetDefaultLevelScaling("Behavior,ImmortalHardenedShield,DamageResponse.Minimum", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusZealot,LifeStart", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusZealot,LifeMax", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusZealot,ShieldsStart", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusZealot,ShieldsMax", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusZealot,ShieldRegenRate", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusStalker,LifeStart", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusStalker,LifeMax", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusStalker,ShieldsStart", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusStalker,ShieldsMax", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusStalker,ShieldRegenRate", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusImmortal,LifeStart", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusImmortal,LifeMax", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusImmortal,ShieldsStart", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusImmortal,ShieldsMax", player);
    libAffx_SetDefaultLevelScaling("Unit,ProbiusImmortal,ShieldRegenRate", player);

    return true;
}
// ============================================================
// Cannon Rush
// ============================================================
bool libAffx_ProbiusCannonRushUnitCreated (bool testConds, bool runActions) {
    unit createdUnit = EventUnitCreatedUnit();
    int owner = UnitGetOwner(createdUnit);
    if (testConds) {
        if (UnitGetType(createdUnit) != "ProbiusPhotonCannon") {
            return false;
        }
        if (owner != libAffx_player) {
            return false;
        }
    }
    UnitBehaviorAdd(createdUnit, "ProbiusPhotonCannonExtenderBehavior", createdUnit, 1);
    return true;
}
// ============================================================
// Optimized Ordnance
// ============================================================
bool libAffx_ProbiusOptimizedOrdnance (bool testConds, bool runActions) {
    unit createdUnit = EventUnitCreatedUnit();
    int owner = UnitGetOwner(createdUnit);
    if (testConds) {
        if (UnitGetType(createdUnit) != "ProbiusPhotonCannon") {
            return false;
        }
        if (owner != libAffx_player) {
            return false;
        }
    }
    UnitBehaviorAdd(createdUnit, "ProbiusOptimizedOrdnanceAttackSpeedBehavior", createdUnit, 1);
    return true;
}
// ============================================================
// Turbo
// ============================================================
bool libAffx_ProbiusTurboAffixAdded (bool testConds, bool runActions) {
    int affixCount = libAffx_EventAffixCount();
    libAffx_ProbiusTurboDurationIncrease = affixCount * 1;
    return true;
}
// ============================================================
// Plasma Shields
// ============================================================
bool libAffx_ProbiusPlasmaShields (bool testConds, bool runActions) {
    unit createdUnit = EventUnitCreatedUnit();
    int owner = UnitGetOwner(createdUnit);
    if (testConds) {
        if (UnitGetType(createdUnit) != "ProbiusPhotonCannon" && UnitGetType(createdUnit) != "ProbiusPylon") {
            return false;
        }
        if (owner != libAffx_player) {
            return false;
        }
    }
    UnitBehaviorAdd(createdUnit, "ProbiusPlasmaShieldsBehavior", createdUnit, 8);
    UnitBehaviorAdd(createdUnit, "ProbiusPlasmaShieldsController", createdUnit, 1);
    return true;
}
// ============================================================
// Pylon Expansion
// ============================================================
bool libAffx_ProbiusPylonExpansionAffixAdded (bool testConds, bool runActions) {
    int amount = libAffx_EventAffixCountAdded();
    libAffx_PylonExpansionAmount += amount;
    libHPRO_gv_heroProbiusWarpInPylonMaxNumberofPylons += amount;
    libHPRO_gv_heroProbiusWarpInPylonConstructAdditionalPylonsMaxNumberofPylons += amount;
    return true;
}
// ============================================================
// Efficient Warp
// ============================================================
bool libAffx_ProbiusEfficientWarpAffixAdded (bool testConds, bool runActions) {
    libAffx_ProbiusZealotCost -= 1;
    libAffx_ProbiusStalkerCost -= 2;
    libAffx_ProbiusImmortalCost -= 6;
    return true;
}
