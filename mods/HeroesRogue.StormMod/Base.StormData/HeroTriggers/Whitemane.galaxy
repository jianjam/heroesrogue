include "AffixTriggers"

const fixed libAffx_WhitemaneArdentZealModifier = 0.25;

bool libAffx_WhitemaneHolySmiteScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,WhitemaneDesperatePleaDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,WhitemaneDesperatePleaRadianceDamage,Amount", player);

    return true;
}

bool libAffx_WhitemaneWhitemanesPunishmentScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,WhitemaneScarletAegisDamage,Amount", player);

    return true;
}

bool libAffx_WhitemaneArdentZealAbilityDamageTracker (bool testConds, bool runActions) {
    fixed damageAbsorbed = EventUnitDamageAbsorbed();
    unit sourceUnit = EventUnitDamageSourceUnit();
    unit eventUnit = EventUnit();
    int player = UnitGetOwner(sourceUnit);
    string damageEffect = EventUnitDamageEffect();

    if (testConds) {
        if (UnitTypeTestAttribute(UnitGetType(eventUnit), c_unitAttributeHeroic)) {
            return false;
        }
        if (UnitBehaviorCount(sourceUnit, "WhitemaneZealCasterBehavior") <= 0) {
            return false;
        }
        if (damageEffect == "WhitemaneZealDamage" || damageEffect == "AffixWeakPointDamage") {
            return false;
        }
        if (!UnitHasBehavior2(sourceUnit, "WhitemaneArdentZealCarry")) {
            return false;
        }
    }

    libHWHI_gv_heroWhitemaneZealCombinedHeal[player] += (damageAbsorbed * libAffx_WhitemaneArdentZealModifier);
    return true;
}
bool libAffx_WhitemaneArdentZealBasicDamageTracker (bool testConds, bool runActions) {
    fixed damageAbsorbed = EventUnitDamageAbsorbed();
    unit sourceUnit = EventUnitDamageSourceUnit();
    unit eventUnit = EventUnit();
    int player = UnitGetOwner(sourceUnit);
    string damageEffect = EventUnitDamageEffect();

    if (testConds) {
        if (UnitTypeTestAttribute(UnitGetType(eventUnit), c_unitAttributeHeroic)) {
            return false;
        }
        if (UnitBehaviorCount(sourceUnit, "WhitemaneZealCasterBehavior") <= 0) {
            return false;
        }
        if (damageEffect == "WhitemaneZealDamage" || damageEffect == "AffixWeakPointDamage") {
            return false;
        }
        if (!UnitHasBehavior2(sourceUnit, "WhitemaneArdentZealCarry")) {
            return false;
        }
    }

    libHWHI_gv_heroWhitemaneZealCombinedHeal[player] += (damageAbsorbed * libAffx_WhitemaneArdentZealModifier);
    return true;
}

bool libAffx_WhitemaneArdentZealOncePerGame (bool testConds, bool runActions) {
    trigger zealNonHeroicAbilityDamageTracker = TriggerCreate("libAffx_WhitemaneArdentZealAbilityDamageTracker");
    trigger zealNonHeroicBasicDamageTracker = TriggerCreate("libAffx_WhitemaneArdentZealBasicDamageTracker");
    TriggerAddDamageEvent(zealNonHeroicAbilityDamageTracker, "HeroWhitemane", null, c_unitDamageTypeAbility, c_unitDamageEither, null);
    TriggerAddDamageEvent(zealNonHeroicBasicDamageTracker, "HeroWhitemane", null, c_unitDamageTypeBasic, c_unitDamageEither, null);
    return true;
}