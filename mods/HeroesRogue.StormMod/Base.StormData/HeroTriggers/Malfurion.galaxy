include "AffixTriggers"


bool libAffx_MalfurionCenariusSpiteScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,RegrowthDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,MalfurionRegrowthMoonfireDamage,Amount", player);

    return true;
}
bool libAffx_MalfurionDreamstateScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,TranquilityDamage,Amount", player);

    return true;
}