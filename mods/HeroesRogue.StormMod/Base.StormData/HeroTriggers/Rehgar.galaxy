include "AffixTriggers"

bool libAffx_RehgarChainSplitScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,RehgarChainHealPrimaryDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,RehgarChainHealSecondaryDamage,Amount", player);

    return true;
}

bool libAffx_RehgarAncestralCurseScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,RehgarAncestralHealingDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,RehgarAncestralHealingFarseersBlessingDamage,Amount", player);

    return true;
}