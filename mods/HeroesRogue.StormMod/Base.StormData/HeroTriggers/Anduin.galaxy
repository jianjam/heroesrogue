include "AffixTriggers"

bool libAffx_AnduinPrayerofDeathScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,AnduinFlashHealDesperatePrayerPrayerofDeathDamage,Amount", player);

    return true;
}

bool libAffx_AnduinHolyLightForAllScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,AnduinFlashHealRenewDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,AnduinFlashHealDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,AnduinPursuedByGraceDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,AnduinLeapOfFaithEnchantBootsLionsSpeedDamage,Amount", player);

    return true;
}

bool libAffx_AnduinDeepWellScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,AnduinLightwellDamage,Amount", player);

    return true;
}