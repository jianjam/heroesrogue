include "AffixTriggers"


// ============================================================
// Unstoppable Avatar
// ============================================================
bool libAffx_MuradinUnstoppableAvatarRespawn (bool testConds, bool runActions) {
    unit respawnedUnit = libGame_gf_HeroRespawnUnit();
    if (testConds) {
        if (UnitGetOwner(respawnedUnit) != libAffx_player) {
            return false;
        }
    }
    libAffx_AddPlayerBehavior(libAffx_player, "MuradinAvatarInitialDelay", 1, true);
    UnitCreateEffectUnit(respawnedUnit, "MuradinAvatarApplyBehaviorsSet", respawnedUnit);
    
    libAffx_RemovePlayerBehavior(libAffx_player, "Ultimate1Unlocked", 1, true);
    return true;
}
bool libAffx_MuradinUnstoppableAvatar (bool testConds, bool runActions) {
    CatalogFieldValueSet(c_gameCatalogBehavior, "MuradinAvatarHealthBuff", "Modification.VitalMaxArray[" + IntToString(0) + "]", libAffx_player, CatalogFieldValueGet(c_gameCatalogBehavior, "MuradinAvatar", "Modification.VitalMaxArray[" + IntToString(0) + "]", libAffx_player));
    
    libAffx_AddPlayerBehavior(libAffx_player, "MuradinAvatarInitialDelay", 1, true);
    UnitCreateEffectUnit(libGame_gv_players[libAffx_player].lv_heroUnit, "MuradinAvatarApplyBehaviorsSet", libGame_gv_players[libAffx_player].lv_heroUnit);

    libAffx_RemovePlayerBehavior(libAffx_player, "Ultimate1Unlocked", 1, true);
    return true;
}
bool libAffx_MuradinUnstoppableAvatarLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    CatalogFieldValueSet(c_gameCatalogBehavior, "MuradinAvatarHealthBuff", "Modification.VitalMaxArray[" + IntToString(0) + "]", libAffx_player, CatalogFieldValueGet(c_gameCatalogBehavior, "MuradinAvatar", "Modification.VitalMaxArray[" + IntToString(0) + "]", libAffx_player));
    return true;
}

// ============================================================
// Dual Hammer
// ============================================================
bool libAffx_MuradinDualHammerAffixAdded (bool testConds, bool runActions) {
    libAffx_CatalogReferenceSet("Abil,MuradinStormBolt,Cost.Charge.CountMax", libAffx_player, "2");
    libAffx_CatalogReferenceSet("Abil,MuradinStormBolt,Cost.Charge.CountStart", libAffx_player, "2");
    libAffx_CatalogReferenceSet("Abil,MuradinStormBolt,Cost.Charge.CountUse", libAffx_player, "1");
    libAffx_CatalogReferenceSet("Abil,MuradinStormBolt,Cost.Charge.TimeUse", libAffx_player, "10");
    libAffx_CatalogReferenceSet("Abil,MuradinStormBolt,Cost.Cooldown.TimeUse", libAffx_player, "0.5");
    libAffx_CatalogReferenceSet("Effect,MuradinHeroWeaponItsHammerTimeStormBoltModifyCooldown,Cost[0].CooldownTimeUse", libAffx_player, "0");
    libAffx_CatalogReferenceSet("Effect,MuradinHeroWeaponItsHammerTimeStormBoltModifyCooldown,Cost[0].ChargeTimeUse", libAffx_player, "-0.5");

    if (PlayerHasTalent(libAffx_player, "MuradinMasteryStormhammerSledgehammer")) {
        libAffx_CatalogReferenceModify("Abil,MuradinStormBolt,Cost.Charge.TimeUse", libAffx_player, "1.5", c_upgradeOperationSubtract);
    }

    return true;
}
bool libAffx_MuradinDualHammerTalentGained (bool testConds, bool runActions) {
    string talent = libGame_gf_HeroGainTalentGainedTalent();
    int player = libGame_gf_HeroGainTalentPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
        if (talent != "MuradinMasteryStormhammerSledgehammer") {
            return false;
        }
    }
    libAffx_CatalogReferenceModify("Abil,MuradinStormBolt,Cost.Charge.TimeUse", libAffx_player, "1.5", c_upgradeOperationSubtract);

    return true;
}

// ============================================================
// Fast Punch
// ============================================================
bool libAffx_MuradinFastPunchTalentGained (bool testConds, bool runActions) {
    string talent = libGame_gf_HeroGainTalentGainedTalent();
    int player = libGame_gf_HeroGainTalentPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
        if (talent != "MuradinMasteryHaymakerGrandSlam") {
            return false;
        }
    }

    libAffx_CatalogReferenceModify("Abil,MuradinHaymaker,Cost.Charge.HideCount", libAffx_player, "0", c_upgradeOperationSet);

    return true;
}