include "AffixTriggers"

bool libAffx_AlexstraszaDeathBinderScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,AlexstraszaLifebinderDoTTarget,Amount", player);

    return true;
}
bool libAffx_AlexstraszaQuickTransformationAffixAdded (bool testConds, bool runActions) {
    unit heroUnit = libAffx_GetPlayerHeroUnit(libAffx_player);
    if (testConds) {
        if (TimerGetElapsed(libGame_gv_gameTimer) > 130) {
            return false;
        }
    }
    UnitCreateEffectUnit(heroUnit, "AlexstraszaDragonqueen0CDModifyUnit", heroUnit);
    return true;
}