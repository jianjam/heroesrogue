include "AffixTriggers"

bool libAffx_LtMoralesNeurotoxinBeamScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,MedicHealingBeamDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,MedicHealingBeamExtendedCareTalentDamage,Amount", player);

    return true;
}