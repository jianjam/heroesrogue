bool libAffx_KharazimExplodingPalmScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,MonkDivinePalmDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,MonkDivinePalmExplosionDamage,Amount", player);
    return true;
}


bool libAffx_KharazimMysticAllyEffectUsed (bool testConds, bool runActions) {
    unit caster = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    point casterLocation = EventPlayerEffectUsedPoint(c_effectLocationCasterPoint);
    int random = RandomInt(1, 3);
    if (random == 1) {
        UnitCreateEffectPoint(caster, "MonkAirAllyCreateUnit", casterLocation);
    } else if (random == 2) {
        UnitCreateEffectPoint(caster, "MonkEarthAllyCreateUnit", casterLocation);
    } else {
        UnitCreateEffectPoint(caster, "MonkSpiritAllyCreateUnit", casterLocation);
    }
    return true;
}
