include "AffixTriggers"

bool libAffx_KharazimScatteredBlowsScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,MonkComboWeaponTranscendenceDamage,Amount", player);
    return true;
}
bool libAffx_KharazimCircleofScornScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,MonkBreathOfHeavenDamage,Amount", player);
    return true;
