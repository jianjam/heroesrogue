include "AffixTriggers"

// ---------------------------------------------------------------
// Teleporter
// ---------------------------------------------------------------
bool libAffx_LiMingTeleporterExecuteOncePerGame (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    
    libAffx_CatalogReferenceSet("Abil,WizardTeleport,Cost[0].Cooldown.TimeUse", libAffx_player, "0.5");
    libAffx_CatalogReferenceSet("Abil,WizardTeleport,Cost[0].Charge.TimeUse", libAffx_player, "5");
    libAffx_CatalogReferenceSet("Abil,WizardTeleport,Cost[0].Charge.CountMax", libAffx_player, "3");
    libAffx_CatalogReferenceSet("Abil,WizardTeleport,Cost[0].Charge.CountStart", libAffx_player, "3");
    libAffx_CatalogReferenceSet("Abil,WizardTeleport,Cost[0].Charge.CountUse", libAffx_player, "1");
    libAffx_CatalogReferenceSet("Effect,WizardArcaneLoopTeleport,Cost[0].ChargeTimeUse", libAffx_player, "-0.5");
    libAffx_CatalogReferenceSet("Effect,WizardAetherWalkerInitialModifyPlayerTeleporter,Chance", libAffx_player, "1");
    libAffx_CatalogReferenceSet("Effect,WizardAetherWalkerInitialModifyPlayer,Chance", libAffx_player, "0");
    libAffx_CatalogReferenceSet("Effect,WizardAetherWalkerExpirationModifyPlayerTeleporter,Chance", libAffx_player, "1");
    libAffx_CatalogReferenceSet("Effect,WizardAetherWalkerExpirationModifyPlayer,Chance", libAffx_player, "0");
    return true;
}
bool libAffx_LiMingTeleporterLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_SetLevelScaling("Effect,WizardTeleportCalamityPvEDamage,Amount", libAffx_player, 0.03);
    return true;
}

// ---------------------------------------------------------------
// Missile Barrage
// ---------------------------------------------------------------
bool libAffx_LiMingMissileBarrageLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_SetLevelScaling("Effect,WizardMagicMissilesDamage2,Amount", libAffx_player, 0.035);
    libAffx_SetLevelScaling("Effect,WizardMagicMissilesDamage2Structure,Amount", libAffx_player, 0.035);
    return true;
}
// ---------------------------------------------------------------
// Critical Power
// ---------------------------------------------------------------
bool libAffx_LiMingCriticalPowerHeroTakedown (bool testConds, bool runActions) {
    int player = libGame_gf_HeroParticipatedInTakedownKillingPlayer();
    unit killerUnit = libGame_gv_players[player].lv_heroUnit;
    unit deadUnit = libGame_gf_HeroParticipatedInTakedownKilledHero();

    if (testConds) {
        if ((player != libAffx_player)) {
            return false;
        }
        if (UnitTestState(deadUnit, c_unitStateHallucination)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    UnitCreateEffectUnit(killerUnit, "LiMingCriticalPowerAddToken", killerUnit);
    
    return true;
}
// ---------------------------------------------------------------
// Need More Mana
// ---------------------------------------------------------------
bool libAffx_LiMingNeedMoreManaHeroTakedown (bool testConds, bool runActions) {
    int player = libGame_gf_HeroParticipatedInTakedownKillingPlayer();
    unit killerUnit = libGame_gv_players[player].lv_heroUnit;
    unit deadUnit = libGame_gf_HeroParticipatedInTakedownKilledHero();

    if (testConds) {
        if ((player != libAffx_player)) {
            return false;
        }
        if (UnitTestState(deadUnit, c_unitStateHallucination)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    UnitCreateEffectUnit(killerUnit, "WizardDominanceManaHealerAffix", killerUnit);
    
    return true;
}

// ---------------------------------------------------------------
// Storm Armor
// ---------------------------------------------------------------
bool libAffx_LiMingStormArmorScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libAffx_SetDefaultLevelScaling("Effect,LiMingStormArmorDamage,Amount", player);

    return true;
}