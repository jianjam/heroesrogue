bool libAffx_LiLiJugof1000000000CupsScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,JugOf1000CupsDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,JugOf1000CupsHealNonHeroic,RechargeVitalRate", player);

    return true;
}