include "AffixTriggers"

bool libAffx_LiLiGoodBrewBadBrewScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,LiLiHealingBrewDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,LiLiHealingBrewTheGoodStuffTalentProcDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,LiLiHealingBrewTheGoodStuffTalentDamage,Amount", player);

    return true;
}

bool libAffx_LiLiPandariasMistweaverScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
