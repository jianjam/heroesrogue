include "AffixTriggers"

bool libAffx_DeckardPoisonousPotionScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,DeckardPoisonousPotionDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,DeckardMegaPoisonousPotionDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,DeckardRejuvenationPotionDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,DeckardPoisonousPotionPotionOfRevivalDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,DeckardLesserPoisonousPotionDamage,Amount", player);

    return true;
}
bool libAffx_DeckardMegaHealingPotionScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,DeckardSuperPoisonousPotionDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,DeckardMegaHealingPotionCreateHealer,Amount", player);

    return true;
}

bool libAffx_DeckardPoisonousPotionTalentGained (bool testConds, bool runActions) {
    string talent = libGame_gf_HeroGainTalentGainedTalent();
    int player = libGame_gf_HeroGainTalentPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
        if (talent != "DeckardPotionOfRevival") {
            return false;
        }
    }
    libAffx_CatalogReferenceModify("Effect,DeckardPoisonousPotionPotionOfRevivalSearch,Chance", player, "1", c_upgradeOperationSet);

    return true;
}
bool libAffx_DeckardPoisonousPotionOncePerGame (bool testConds, bool runActions) {
    if (PlayerHasTalent(libAffx_player, "DeckardPotionOfRevival")) {
        libAffx_CatalogReferenceModify("Effect,DeckardPoisonousPotionPotionOfRevivalSearch,Chance", libAffx_player, "1", c_upgradeOperationSet);
    }
    return true;
}

bool libAffx_DeckardPotionSellerTalentGained (bool testConds, bool runActions) {
    string talent = libGame_gf_HeroGainTalentGainedTalent();
    int player = libGame_gf_HeroGainTalentPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
        if (talent != "DeckardPotionOfRevival") {
            return false;
        }
    }
    libAffx_CatalogReferenceModify("Effect,DeckardHealingPotionPotionOfRevivalNonHeroicSearch,Chance", player, "1", c_upgradeOperationSet);

    return true;
}
bool libAffx_DeckardPotionSellerOncePerGame (bool testConds, bool runActions) {
    if (PlayerHasTalent(libAffx_player, "DeckardPotionOfRevival")) {
        libAffx_CatalogReferenceModify("Effect,DeckardHealingPotionPotionOfRevivalNonHeroicSearch,Chance", libAffx_player, "1", c_upgradeOperationSet);
    }
    return true;
}