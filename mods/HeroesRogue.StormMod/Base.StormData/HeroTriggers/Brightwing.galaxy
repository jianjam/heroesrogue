include "AffixTriggers"

bool libAffx_BrightwingFaerieMistScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,BrightwingSoothingMistDamage,Amount", player);
    libAffx_SetDefaultLevelScaling("Effect,BrightwingCalmingMistEnemyDamage,Amount", player);

    return true;
}

bool libAffx_BrightwingEtherealBlinkScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,BlinkHealInitialDamage,Amount", player);

    return true;
}