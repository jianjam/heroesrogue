// ============================================================
// Private Medivac
// ============================================================

bool libAffx_PrivateMedivacAffixAdded (bool testConds, bool runActions) {
    libAffx_PrivateMedivacIndex = libAffx_EventAffix();
    return true;
}

bool libAffx_PrivateMedivacUnitDied (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    int deadPlayer = UnitGetOwner(deadUnit);
    point deadPos = UnitGetPosition(deadUnit);
    point currentPos;
    point medivacPos;
    unit medivac;
    bool[libCore_gv_bALMaxPlayers + 1] playerInMedivac;

    if (testConds) {
        if (libAffx_PrivateMedivacIndex == 0) {
            return false;
        }
        if (libAffx_affixes[libAffx_PrivateMedivacIndex].cooldown > 0) {
            return false;
        }
        if (deadPlayer != libAffx_player) {
            return false;
        }
        if (UnitGetType(deadUnit) == "HeroMurky" && !((UnitIsAlive(libGame_gv_heroDeathMurkyRespawnEggs[deadPlayer]) == false) || (libGame_gv_heroDeathMurkyRespawnEggs[deadPlayer] == null))) {
            return false;
        }
        if (UnitGetType(deadUnit) == "HeroUther" && PlayerHasTalent(deadPlayer, "UtherMasteryRedemption") && libGame_UtherRedemptionIsReady(deadUnit)) {
            return false;
        }
    }
    while (!UnitIsAlive(deadUnit)) {
        Wait(0.0625, c_timeGame);
    }
    libAffx_affixes[libAffx_PrivateMedivacIndex].cooldown = libAffx_PrivateMedivacCooldown;

    libAffx_DisplayDebugMessage("Medivac departs!");
    currentPos = UnitGetPosition(deadUnit);
    libCore_gf_CreateMinimapPingStorm(PlayerGroupAll(), "StormObjective", currentPos, ColorWithAlpha(0,0,0,0), 2.0);
    SoundPlayAtPointForPlayer(SoundLink("PVE_MercMedivac_Alert", -1), c_maxPlayers, PlayerGroupAll(), currentPos, 0.0, 100.0, 0.0);
    libNtve_gf_UnitCreateFacingPoint(1, "MedicMedivacDropship", c_unitCreateIgnorePlacement, libAffx_teamOrder, currentPos, deadPos, null);
    medivac = UnitLastCreated();
    libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(medivac), c_animNameDefault, "Birth", c_animFlagNonLooping, 0.0);
    libNtve_gf_SendActorMessageToUnit(medivac, "MinimapIcon Assets\\Textures\\storm_temp_btn-unit-terran-medivac.dds");
    libNtve_gf_SendActorMessageToUnit(medivac, "MinimapIconScale 0.350000");
    libNtve_gf_MakeUnitInvulnerable(medivac, true);
    while (!UnitHasBehavior2(medivac, "MedicMedivacDropshipEnRoute") && UnitGroupCount(UnitCargoGroup(medivac), c_unitCountAll) <= 0) {
        Wait(0.0625, c_timeGame);
    }
    if (UnitGroupCount(UnitCargoGroup(medivac), c_unitCountAll) > 0) {
        UnitSelect(libGame_gv_players[deadPlayer].lv_heroUnit, deadPlayer, true);
        libGame_gv_players[deadPlayer].lv_cameraForcedLock = true;
        libGame_gv_players[deadPlayer].lv_cameraPlayerUnitGroupToFocusOn = libNtve_gf_ConvertUnitToUnitGroup(medivac);
        libGame_gf_CameraUpdateCameraForPlayer(deadPlayer);
        playerInMedivac[deadPlayer] = true;
    }
    libNtve_gf_MakeUnitUncommandable(medivac, true);
    UnitBehaviorSetDuration(medivac, "MedicMedivacDropshipDepartureDelay", 0.0625);
    libAffx_Wait(0.5, c_timeGame);
    UnitIssueOrder(medivac, OrderTargetingPoint(AbilityCommand("move", 0), deadPos), c_orderQueueAddToEnd);
    libAffx_Wait(0.5, c_timeGame);

    while (UnitIsAlive(medivac) && (UnitBehaviorCount(medivac, "MedicMedivacDropshipEnRoute") == 1)) {
        medivacPos = UnitGetPosition(medivac);
        if ((DistanceBetweenPoints(medivacPos, deadPos) <= 5.0)) {
            UnitBehaviorRemove(medivac, "MedicMedivacDropshipDepartureAscent", 1);
        }
        if ((DistanceBetweenPoints(medivacPos, deadPos) <= 1.0)) {
            UnitBehaviorSetDurationRemaining(medivac, "MedicMedivacDropshipDropoffLocationTimedLife", 0.0);
            UnitBehaviorRemove(medivac, "MedicMedivacDropshipEnRoute", 1);
        }
        Wait(0.0625, c_timeGame);
    }

    if (playerInMedivac[deadPlayer]) {
        libGame_gv_players[deadPlayer].lv_cameraForcedLock = false;
        libGame_gv_players[deadPlayer].lv_cameraPlayerUnitGroupToFocusOn = libGame_gv_players[deadPlayer].lv_heroUnitGroup;
        UnitSelect(medivac, deadPlayer, false);
        UnitSelect(libGame_gv_players[deadPlayer].lv_heroUnit, deadPlayer, true);
        libNtve_gf_RestoreUnitSelection(deadPlayer);
        libGame_gf_CameraUpdateCameraForPlayer(deadPlayer);
    }

    libAffx_Wait(6, c_timeGame);
    UnitRemove(medivac);

    return true;
}

bool libAffx_PrivateMedivacPeriodic (bool testConds, bool runActions) {
    if (testConds) {
        if (libAffx_PrivateMedivacIndex == 0 ) {
            return false;
        }
        if (libAffx_gamePaused || libAffx_affixes[libAffx_PrivateMedivacIndex].cooldown <= 0) {
            return false;
        }
    }

    libAffx_affixes[libAffx_PrivateMedivacIndex].cooldown -= 0.0625;

    return true;
}

// ============================================================
// Weaken
// ============================================================
bool libAffx_WeakenAffixAdded (bool testConds, bool runActions) {
    libAffx_WeakenCurrentModifier = libAffx_WeakenModifier * libAffx_EventAffixCount();
    return true;
}
bool libAffx_WeakenUnitCreated (bool testConds, bool runActions) {
    unit eventUnit = EventUnitCreatedUnit();
    if (testConds) {
        if (!libAffx_UnitMatchesFilter(eventUnit, libAffx_filterEnemyMinions)) {
            return false;
        }
    }
    libAffx_Wait(0.0625, c_timeGame);
    UnitSetPropertyFixed(eventUnit, c_unitPropLife, UnitGetPropertyFixed(eventUnit, c_unitPropLife, true) * (1 - libAffx_WeakenCurrentModifier));
    return true;
}

// ============================================================
// Quick Mount
// ============================================================
bool libAffx_QuickMountOncePerGame (bool testConds, bool runActions) {
    int i;
    for (i = 1; i <= 5; i += 1) {
        libAffx_CatalogReferenceSet("Abil,Mount,CastIntroTime[0]", i, FixedToString(libAffx_CatalogReferenceGetAsFixed("Abil,Mount,CastIntroTime[0]", 0) * libAffx_QuickMountModifier, 2));
        libAffx_CatalogReferenceSet("Abil,Mount,Cost[0].Cooldown.TimeUse", i, FixedToString(libAffx_CatalogReferenceGetAsFixed("Abil,Mount,Cost[0].Cooldown.TimeUse", 0) * libAffx_QuickMountModifier, 2));
        libAffx_CatalogReferenceSet("Effect,DismountModifyCooldown,Cost[0].CooldownTimeUse", i, FixedToString(libAffx_CatalogReferenceGetAsFixed("Effect,DismountModifyCooldown,Cost[0].CooldownTimeUse", 0) * libAffx_QuickMountModifier, 2));
    }
    TriggerAddEventGeneric(TriggerCreate("libAffx_QuickMountCostsChanged"), libGame_mountCostsChangedEventName);
    return true;
}

bool libAffx_QuickMountCostsChanged (bool testConds, bool runActions) {
    int player = libGame_EventMountCostsChangedPlayer();
    bool onOff = libGame_EventMountCostsChangedOnOff();
    if (onOff) {
        libAffx_CatalogReferenceSet("Abil,Mount,CastIntroTime[0]", player, FixedToString(libAffx_CatalogReferenceGetAsFixed("Abil,Mount,CastIntroTime[0]", 0) * libAffx_QuickMountModifier, 2));
        libAffx_CatalogReferenceSet("Abil,Mount,Cost[0].Cooldown.TimeUse", player, FixedToString(libAffx_CatalogReferenceGetAsFixed("Abil,Mount,Cost[0].Cooldown.TimeUse", 0) * libAffx_QuickMountModifier, 2));
        libAffx_CatalogReferenceSet("Effect,DismountModifyCooldown,Cost[0].CooldownTimeUse", player, FixedToString(libAffx_CatalogReferenceGetAsFixed("Effect,DismountModifyCooldown,Cost[0].CooldownTimeUse", 0) * libAffx_QuickMountModifier, 2));
    }
    return true;
}

// ============================================================
// True Stealth
// ============================================================
bool libAffx_TrueStealthHeroRespawn (bool testConds, bool runActions) {
    unit respawnedUnit = libGame_gf_HeroRespawnUnit();
    int player = UnitGetOwner(respawnedUnit);
    if (testConds) {
        if (player < 6 || player > 10) {
            return false;
        }
    }
    libNtve_gf_SendActorMessageToUnit(respawnedUnit, "SetMinimapVisibility 0");
    libNtve_gf_SendActorMessageToUnit(respawnedUnit, "SetMinimapVisibilityAlways 0");
    
    return true;
}
bool libAffx_TrueStealthUnitCreated (bool testConds, bool runActions) {
    unit eventUnit = EventUnitCreatedUnit();
    int player = UnitGetOwner(eventUnit);
    if (testConds) {
        if (player < 6 || player > 10) {
            return false;
        }
        if (UnitGetType(eventUnit) != "RexxarMisha" && UnitGetType(eventUnit) != "HeroDVaMech") {
            return false;
        }
    }
    libNtve_gf_SendActorMessageToUnit(eventUnit, "SetMinimapVisibility 0");
    libNtve_gf_SendActorMessageToUnit(eventUnit, "SetMinimapVisibilityAlways 0");
    return true;
}
bool libAffx_TrueStealthOncePerGame (bool testConds, bool runActions) {
    int i;
    for (i = 6; i <= 10; i += 1) {
        libAffx_SendActorMessageToPlayer(i, "SetMinimapVisibility 0");
        libAffx_SendActorMessageToPlayer(i, "SetMinimapVisibilityAlways 0");
    }
    
    return true;
}

