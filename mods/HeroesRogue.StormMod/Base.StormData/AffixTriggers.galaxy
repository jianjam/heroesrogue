// ============================================================
// Experience Hoarder
// ============================================================
bool libAffx_ExperienceHoarderAffixAdded (bool testConds, bool runActions) {
    fixed xp = libAffx_BankLoadValueFixed("ExperienceHoarderXP");
    int player;
    playergroup playerGroup;
    if (xp > 0) {
        if (libGame_sharedXPDisabled[libGame_gv_teamOrderIndex_C]) {
            libGame_gf_GrantXPToPlayer(xp, libAffx_player, libGame_ge_XPSources_External);
        } else {
            playerGroup = PlayerGroupCopy(libGame_gf_AlliedPlayerGroupOfPlayer(libAffx_player));
            while (true) {
                player = PlayerGroupNextPlayer(playerGroup, player);
                if (player<0) { break; }
                libGame_gf_GrantXPToPlayer(xp, player, libGame_ge_XPSources_External);
            }
        }
    }

    return true;
}
bool libAffx_ExperienceHoarderWin (bool testConds, bool runActions) {
    libAffx_BankSaveValueFixed("ExperienceHoarderXP", UnitXPTotal(libGame_gv_players[libAffx_player].lv_heroUnit) * 0.20);

    return true;
}
// ============================================================
// Pacifism
// ============================================================
bool libAffx_PacifismAffixAdded (bool testConds, bool runActions) {
    libAffx_PacifismIndex = libAffx_EventAffix();
    if (libAffx_BankLoadValueInt(libAffx_affixes[libAffx_PacifismIndex].name + "_PacifismReady") == 1) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringExternal("Message/Pacifism"));
        libAffx_QueueBoon(libAffx_rarityUncommon, 1, false, true);
        libAffx_QueueBoon(libAffx_rarityRare, 1, false, true);
        libAffx_QueueBoon(libAffx_rarityEpic, 1, false, true);
        libAffx_AddSaveBankInt(libAffx_PacifismIndex, "PacifismReady", 0);
    }
    
    return true;
}
bool libAffx_PacifismWin (bool testConds, bool runActions) {
    fixed takedowns = libGame_gv_scoreValues[libAffx_player].lv_takedowns;
    fixed kills = libGame_gv_scoreValues[libAffx_player].lv_kills;
    fixed assists = libGame_gv_scoreValues[libAffx_player].lv_assists;
    if (testConds) {
        if (libAffx_PacifismIndex == 0) {
            return false;
        }
        if (libAffx_affixes[libAffx_PacifismIndex].quest.questDone) {
            return false;
        }
    }
    if ((takedowns + kills + assists) <= 0) {
        libAffx_affixes[libAffx_PacifismIndex].quest.questDone = true;
        libAffx_BankSaveValueInt(libAffx_affixes[libAffx_PacifismIndex].name + "_PacifismReady", 1);
    }
    
    return true;
}
