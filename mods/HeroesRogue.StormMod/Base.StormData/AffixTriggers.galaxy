void libAffx_UpdatePathoftheAssassin(int player) {
    int level = UnitLevel(libGame_gv_players[player].lv_heroUnit);
    if (libAffx_PathoftheAssassinIndex == 0) {
        return;
    }
    libAffx_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixPathoftheAssassinBehavior", "Modification.DamageDealtScaled[Basic]", player, (libAffx_PathoftheAssassinInitialValue[player] + libAffx_PathoftheAssassinStackingValue[player] * (libAffx_affixes[libAffx_PathoftheAssassinIndex].count - 1)) * (level + libAffx_PathoftheFighterBonus));
}
bool libAffx_PathoftheAssassinExecuteImmediate (bool testConds, bool runActions) {
    int i;
    string hero;
    for (i = 1; i <= libCore_gv_bALMaxPlayers; i += 1) {
        hero = libCore_gf_GetHeroFromIndex(libAffx_playersHeroIndex[i]);

        if (hero == "Tracer") {
            libAffx_PathoftheAssassinInitialValue[i] = 1;
            libAffx_PathoftheAssassinStackingValue[i] = 1;
        } else if (hero == "DVa" || hero == "Tassadar" || hero == "Tychus" || hero == "Zarya" || hero == "Lucio" || hero == "Genji") {
            libAffx_PathoftheAssassinInitialValue[i] = 2;
            libAffx_PathoftheAssassinStackingValue[i] = 1;
        } else {
            libAffx_PathoftheAssassinInitialValue[i] = 4;
            libAffx_PathoftheAssassinStackingValue[i] = 2;
        }
    }
    libAffx_PathoftheAssassinInitialValueTooltip = libAffx_PathoftheAssassinInitialValue[libAffx_player];
    libAffx_PathoftheAssassinStackingValueTooltip = libAffx_PathoftheAssassinStackingValue[libAffx_player];
    return true;
}
bool libAffx_PathoftheAssassinAffixAdded (bool testConds, bool runActions) {
    int i;
    libAffx_PathoftheAssassinIndex = libAffx_EventAffix();

    for (i = 1; i <= libCore_gv_bALMaxPlayers; i += 1) {
        libAffx_UpdatePathoftheAssassin(i);
    }
    
    return true;
}
bool libAffx_PathoftheAssassinLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (!UnitHasBehavior2(libGame_gv_players[player].lv_heroUnit, "AffixPathoftheAssassinBehavior")) {
            return false;
        }
        if (libAffx_PathoftheAssassinIndex == 0) {
            return false;
        }
    }
    libAffx_UpdatePathoftheAssassin(player);
    return true;
}
