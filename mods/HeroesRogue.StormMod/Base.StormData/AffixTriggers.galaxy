// ============================================================
// Ring of Magic
// ============================================================
bool libAffx_RingofMagicBehaviorChange (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    int player = UnitGetOwner(eventUnit);
    string cooldownLink;
    while ((UnitHasBehavior2(eventUnit, "AffixRingofMagicBehavior") == true)) {
        while ((UnitHasBehaviorWithCategoryFlag(eventUnit, c_behaviorCategoryTimeStop) == true) || libAffx_gamePaused) {
            Wait(0.0625, c_timeGame);
        }
        libAffx_ModifyAllCooldowns(eventUnit, -(libAffx_RingofMagicCurrentModifier) / 16, true, true, false);
        Wait(0.0625, c_timeGame);
    }
    return true;
}
bool libAffx_RingofMagicAffixAdded (bool testConds, bool runActions) {
    int count = libAffx_EventAffixCount();
    libAffx_RingofMagicCurrentModifier = libAffx_RingofMagicModifier + (libAffx_RingofMagicModifierPerStack * (count - 1));
    return true;
}

