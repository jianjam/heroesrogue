        libAffx_AddExcludedUnitTypeFilter(libAffx_filterCitadel, "KingsCore");
    }
    libAffx_AddUnitBehaviorToAllFilter("CitadelBuff", 1, libAffx_filterCitadel);

    return true;
}
// ============================================================
// Level Disadvantage
// ============================================================
bool libAffx_LevelDisadvantageOncePerGame (bool testConds, bool runActions) {
    int i;
    int i2;
    int heroLevel;
    unit heroUnit;
    for (i = 1; i <= 4; i += 1) {
        for (i2 = 6; i2 <= 10; i2 += 1) {
            heroUnit = libGame_gv_players[i2].lv_heroUnit;
            heroLevel = UnitLevel(heroUnit);
            if (heroLevel < 4) {
                UnitXPAddXP(heroUnit, null, StringToFixed(CatalogReferenceGet("Behavior,HeroXPCurve,VeterancyLevelArray[" + IntToString(heroLevel) +"].MinVeterancyXP", i2)) + 1);
            }
        }
    }
    libGame_xpModifier[libGame_gv_teamChaosIndex_C] += 0.25;

    return true;
}
// ============================================================
// Cursed
// ============================================================
bool libAffx_CursedAffixAdded (bool testConds, bool runActions) {
    libAffx_CursedIndex = libAffx_EventAffix();
    return true;
}
bool libAffx_CursedOncePerGame (bool testConds, bool runActions) {
    libAffx_maxAffixesFromObjectives -= 1;
    return true;
}
bool libAffx_CursedHeroKilled (bool testConds, bool runActions) {
    unit deadUnit = libGame_gf_HeroKilledUnit();
    int deadPlayer = libGame_gf_HeroKilledPlayer();
    int killingPlayer = libGame_gf_HeroKilledKillingPlayer();
    int i;
    if (testConds) {
        if (libGame_gv_gameOver) {
            return false;
        }
        if (deadPlayer != libAffx_player) {
            return false;
        }
        if (!(UnitTestState(deadUnit, c_unitStateHallucination) == false)) {
            return false;
        }
        if (!UnitTypeTestAttribute(UnitGetType(deadUnit), c_unitAttributeHeroic)) {
            return false;
        }
    }
    libAffx_affixes[libAffx_CursedIndex].customInt += 1;
    if (libAffx_affixes[libAffx_CursedIndex].customInt >= 3) {
        libAffx_affixes[libAffx_CursedIndex].customInt = 0;
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringExternal("Message/CurseCursed"));
        libAffx_QueueCurse(1, false);
    }
    return true;
}
bool libAffx_CursedLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libAffx_player) {
            return false;
        }
        if (level < 20) {
            return false;
        }
        if (libAffx_affixes[libAffx_CursedIndex].customBool) {
            return false;
        }
    }
    if (level <= 0) {
        return true;
    }
    libAffx_affixes[libAffx_CursedIndex].customBool = true;
    libAffx_affixes[libAffx_CursedIndex].cooldown = 60;
    TriggerAddEventTimePeriodic(TriggerCreate("libAffx_CursedPeriodic"), 0.0625, c_timeGame);
    TriggerAddEventUnitCreated(TriggerCreate("libAffx_CursedUnitCreated"), null, null, null);
    TriggerAddEventUnitChangeOwner(TriggerCreate("libAffx_CursedUnitChangeOwner"), null);
    libAffx_AddUnitBehaviorToAllFilter("CursedDebuff", 1, libAffx_filterAllAllies);
    
    return true;
}
bool libAffx_CursedUnitCreated (bool testConds, bool runActions) {
    if (testConds) {
        if (!libAffx_affixes[libAffx_CursedIndex].customBool) {
            return false;
        }
    }
    libAffx_AddUnitBehaviorFilter(EventUnitCreatedUnit(), "CursedDebuff", 1, libAffx_filterAllAllies);
    return true;
}
bool libAffx_CursedUnitChangeOwner (bool testConds, bool runActions) {
    if (testConds) {
        if (!libAffx_affixes[libAffx_CursedIndex].customBool) {
            return false;
        }
    }
    libAffx_UpdateUnitBehaviorFilter(EventUnit(), "CursedDebuff", 1, libAffx_filterAllAllies);
    return true;
}
bool libAffx_CursedPeriodic (bool testConds, bool runActions) {
    int level;
    if (testConds) {
        if (!libAffx_affixes[libAffx_CursedIndex].customBool) {
            return false;
        }
        if (libAffx_gamePaused) {
            return false;
        }
        if (!libAffx_GateIsOpen()) {
            return false;
        }
    }
    if (libAffx_affixes[libAffx_CursedIndex].cooldown <= 0) {
        level = UnitLevel(libGame_gv_players[libAffx_player].lv_heroUnit);
        if (level < 30) {
            libAffx_CatalogModifyForAllPlayers("Behavior,CursedDebuff,ArmorModification.AllArmorBonus", FixedToString(StringToFixed(CatalogReferenceGet("Behavior,CursedDebuff,ArmorModification.AllArmorBonus", libAffx_player)) - 5, 0));
            libAffx_affixes[libAffx_CursedIndex].cooldown = 60;
        } else {
            libAffx_CatalogModifyForAllPlayers("Behavior,CursedDebuff,ArmorModification.AllArmorBonus", FixedToString(StringToFixed(CatalogReferenceGet("Behavior,CursedDebuff,ArmorModification.AllArmorBonus", libAffx_player)) - 100, 0));
            libAffx_affixes[libAffx_CursedIndex].cooldown = 60;
        }
    } else {
        libAffx_affixes[libAffx_CursedIndex].cooldown -= 0.0625;
    }
    return true;
}

