// ============================================================
// Reinforced Walls
// ============================================================
bool libAffx_ReinforcedWallsUnitCreated (bool testConds, bool runActions) {
    libAffx_AddUnitBehaviorFilter(EventUnitCreatedUnit(), "AffixReinforcedWallsBuff", 1, libAffx_filterReinforcedWalls);
    return true;
}
bool libAffx_ReinforcedWallsAffixAdded (bool testConds, bool runActions) {
    libAffx_CopyFilter(libAffx_filterAlliedStructures, libAffx_filterReinforcedWalls);
    if (libAffx_currentMap == libAffx_mapTowersofDoom) {
        libAffx_AddExcludedUnitTypeFilter(libAffx_filterReinforcedWalls, "KingsCore");
    }
    libAffx_AddUnitBehaviorToAllFilter("AffixReinforcedWallsBuff", 1, libAffx_filterReinforcedWalls);
    return true;
}
bool libAffx_ReinforcedWallsUnitChangeOwner (bool testConds, bool runActions) {
    libAffx_UpdateUnitBehaviorFilter(EventUnit(), "AffixReinforcedWallsBuff", 1, libAffx_filterReinforcedWalls);
    return true;
}
// ============================================================
// Nano Boost
// ============================================================
bool libAffx_NanoBoostAffixAdded (bool testConds, bool runActions) {
    libAffx_NanoBoostCurrentCDRModifier = libAffx_NanoBoostCDRModifier * libAffx_EventAffixCount();
    return true;
}
bool libAffx_NanoBoostBehaviorChange (bool testConds, bool runActions) {
    unit heroUnit = EventUnit();
    while (UnitHasBehavior2(heroUnit, "AffixNanoBoost")) {
        while ((UnitHasBehaviorWithCategoryFlag(heroUnit, c_behaviorCategoryTimeStop) == true) || libAffx_gamePaused) {
            Wait(0.0625, c_timeGame);
        }
        libAffx_ModifyAllCooldowns(heroUnit, -(libAffx_NanoBoostCurrentCDRModifier / 16), false, false, false);
        Wait(0.0625, c_timeGame);
    }
    return true;
}
// ============================================================
// Blessing of the Dragons
// ============================================================
bool libAffx_BlessingoftheDragonsAffixAdded (bool testConds, bool runActions) {
    libAffx_BlessingoftheDragonsCurrentCDRModifier = libAffx_BlessingoftheDragonsCDRModifier * libAffx_EventAffixCount();
    return true;
}
bool libAffx_BlessingoftheDragonsBehaviorChange (bool testConds, bool runActions) {
    while ((UnitHasBehavior2(EventUnit(), "AffixBlessingoftheDragons") == true)) {
        while ((UnitHasBehaviorWithCategoryFlag(EventUnit(), c_behaviorCategoryTimeStop) == true) || libAffx_gamePaused) {
            Wait(0.0625, c_timeGame);
        }
        libAffx_ModifyAllCooldowns(EventUnit(), -(libAffx_BlessingoftheDragonsCurrentCDRModifier / 16), false, false, false);
        Wait(0.0625, c_timeGame);
    }
    return true;
}
// ============================================================
// BUDDY
// ============================================================
void libAffx_AddBuddy(int player, unit ownerUnit, int count) {
    if (UnitGetType(ownerUnit) == "HeroErik") {
        libAffx_CurrentBuddyCount3[player] += count;
    } else if (UnitGetType(ownerUnit) == "HeroBaleog" || UnitGetType(ownerUnit) == "RexxarMisha") {
        libAffx_CurrentBuddyCount2[player] += count;
    } else {
        libAffx_CurrentBuddyCount1[player] += count;
    }
}
int libAffx_GetBuddyCount(int player, unit ownerUnit) {
    if (UnitGetType(ownerUnit) == "HeroErik") {
        return libAffx_CurrentBuddyCount3[player];
    } else if (UnitGetType(ownerUnit) == "HeroBaleog" || UnitGetType(ownerUnit) == "RexxarMisha") {
        return libAffx_CurrentBuddyCount2[player];
    } else {
        return libAffx_CurrentBuddyCount1[player];
    }
}
bool libAffx_BuddyAI (bool testConds, bool runActions) {
    const int buddyIdleState = 1;
    const int buddyLeashingState = 2;
    const int buddyMovingState = 3;
    const int buddyCirclingState = 4;

    fixed buddyFollowRange = 8;
    fixed buddyTeleportRange = buddyFollowRange * 3;

    unit ownerUnit = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    unit buddyUnit;
    int ownerPlayer = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    int currentState = buddyIdleState;
    fixed circleAngle;
    unit activeUnit;
    if (testConds) {
        if (UnitGetType(ownerUnit) == "HeroLostVikingsController") {
            return false;
        }
        if (UnitGetType(ownerUnit) == "LongboatRaidBoat") {
            return false;
        }
        if (libAffx_CurrentBuddyCount1[ownerPlayer] >= libAffx_BuddyCount[ownerPlayer]) {
            return false;
        }
    }

    libNtve_gf_CreateUnitsAtPoint2(1, "AffixBuddyDrone", 0, ownerPlayer, PointWithOffsetPolar(UnitGetPosition(ownerUnit), 1.5, libNtve_gf_RandomAngle()), ownerUnit);
    buddyUnit = UnitLastCreated();
    UnitGroupAdd(libGame_gv_players[ownerPlayer].lv_summonedUnitGroup, buddyUnit);
    libAffx_AddBuddy(ownerPlayer, ownerUnit, 1);
    circleAngle = RandomFixed(0, 360);
    while ((UnitIsAlive(buddyUnit) == true) && (UnitIsAlive(ownerUnit) == true) && (UnitHasBehavior2(ownerUnit, "Dead") == false)) {
        circleAngle += 2.15;
        if (circleAngle >= 360) {
            circleAngle -= 360;
        }
        if (UnitGetType(ownerUnit) == "HeroAbathur" && UnitHasBehavior2(ownerUnit, "SymbioteCasterDummyBehavior")) { 
            activeUnit = libGDHL_gv_heroAbathurSymbioteUnit[ownerPlayer];
        } else if (UnitGetType(ownerUnit) == "HeroAbathur" && UnitHasBehavior2(ownerUnit, "AbathurUltimateEvolutionVehicleCasterBehavior")) { 
            activeUnit = libGame_gv_players[ownerPlayer].lv_activeVehicle;
        } else if (libGame_gv_players[ownerPlayer].lv_activeVehicle != null && libNtve_gf_UnitIsInsideTransport(ownerUnit)) {
            activeUnit = UnitTransport(ownerUnit);
        } else if (UnitGetType(ownerUnit) == "HeroDVaPilot" && libNtve_gf_UnitIsInsideTransport(ownerUnit)) {
            activeUnit = UnitTransport(ownerUnit);
        } else if (UnitHasBehavior2(ownerUnit, "LongboatRaidHideVikings")) {
            activeUnit = libGDHL_gv_lostVikingsPlayer[ownerPlayer].lv_boat;
        } else {
            activeUnit = ownerUnit;
        }
        
        while (UnitHasBehaviorWithCategoryFlag(activeUnit, c_behaviorCategoryTimeStop)) {
            UnitGroupRemove(libGame_gv_players[ownerPlayer].lv_summonedUnitGroup, buddyUnit);
            UnitKill(buddyUnit);
            Wait(0.0625, c_timeGame);
        }
        // Heal owner
        if (UnitGroupCount(UnitGetTrackedUnitGroup(buddyUnit, "AffixBuddyHealUnitTracker"), c_unitCountAll) <= 0) {
            if (UnitHasBehavior2(activeUnit, "StormEarthFireCasterBehavior")) {
                UnitIssueOrder(buddyUnit, OrderTargetingUnit(AbilityCommand("AffixBuddyHeal", 0), UnitGroupUnit(libGDHL_gv_heroChenStormEarthFireUnits[ownerPlayer].lv_stormEarthFireUnits, 1)), c_orderQueueReplace);
                UnitIssueOrder(buddyUnit, OrderTargetingUnit(AbilityCommand("AffixBuddyHeal", 0), UnitGroupUnit(libGDHL_gv_heroChenStormEarthFireUnits[ownerPlayer].lv_stormEarthFireUnits, 2)), c_orderQueueReplace);
                UnitIssueOrder(buddyUnit, OrderTargetingUnit(AbilityCommand("AffixBuddyHeal", 0), UnitGroupUnit(libGDHL_gv_heroChenStormEarthFireUnits[ownerPlayer].lv_stormEarthFireUnits, 3)), c_orderQueueReplace);
            } else if (ownerPlayer == libAffx_gallPlayer) {
                UnitIssueOrder(buddyUnit, OrderTargetingUnit(AbilityCommand("AffixBuddyHeal", 0), libGame_gv_players[libAffx_choPlayer].lv_heroUnit), c_orderQueueReplace);
            } else if (UnitGetType(activeUnit) == "AbathurSymbiote" && UnitTypeTestAttribute(UnitGetType(libGDHL_gv_heroAbathurSymbioteHost[ownerPlayer]), c_unitAttributeHeroic)) {
                UnitIssueOrder(buddyUnit, OrderTargetingUnit(AbilityCommand("AffixBuddyHeal", 0), libGDHL_gv_heroAbathurSymbioteHost[ownerPlayer]), c_orderQueueReplace);
            } else {
                UnitIssueOrder(buddyUnit, OrderTargetingUnit(AbilityCommand("AffixBuddyHeal", 0), activeUnit), c_orderQueueReplace);
            }
        }
        // Movement
        if (UnitOrderCount(buddyUnit) <= 1) {
            if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) >= buddyTeleportRange)) {
                UnitSetPosition(buddyUnit, PointWithOffsetPolar(UnitGetPosition(activeUnit), 1.5, libNtve_gf_RandomAngle()), false);
                UnitIssueOrder(buddyUnit, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
                currentState = buddyIdleState;
            }
            else if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) >= buddyFollowRange) && (currentState != buddyLeashingState)) {
                UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(activeUnit), -1.0, UnitGetFacing(activeUnit))), c_orderQueueReplace);
                currentState = buddyLeashingState;
            }

            if (currentState == buddyIdleState && UnitOrderCount(buddyUnit) != 0 && OrderGetAbilityCommand(UnitOrder(activeUnit, 0)) == AbilityCommand("move", 0)) {
                if ((DistanceBetweenPoints(OrderGetTargetPosition(UnitOrder(activeUnit, 0)), UnitGetPosition(buddyUnit)) > buddyFollowRange)) {
                    UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(OrderGetTargetPosition(UnitOrder(activeUnit, 0)), 1.0, UnitGetFacing(activeUnit))), c_orderQueueReplace);
                    currentState = buddyMovingState;
                }
            }
            
            if (currentState == buddyIdleState && UnitOrderCount(buddyUnit) == 0) {
                currentState = buddyCirclingState;
                UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(activeUnit), buddyFollowRange / 1.75, circleAngle)), c_orderQueueReplace);
            } else if (currentState == buddyCirclingState) {
                UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(activeUnit), buddyFollowRange / 1.75, circleAngle)), c_orderQueueReplace);
            } else if (currentState == buddyMovingState) {
                if ((UnitOrderCount(buddyUnit) == 0)) {
                    currentState = buddyIdleState;
                } else {
                    if ((UnitOrderCount(activeUnit) == 0)) {
                        if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) <= buddyFollowRange)) {
                            UnitIssueOrder(buddyUnit, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
                            currentState = buddyIdleState;
                        }
                    }
                    else if ((OrderGetAbilityCommand(UnitOrder(activeUnit, 0)) == AbilityCommand("move", 0))) {
                        if ((DistanceBetweenPoints(OrderGetTargetPosition(UnitOrder(activeUnit, 0)), OrderGetTargetPosition(UnitOrder(buddyUnit, 0))) > buddyFollowRange / 2)) {
                            UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(OrderGetTargetPosition(UnitOrder(activeUnit, 0)), 1.0, UnitGetFacing(activeUnit))), c_orderQueueReplace);
                            currentState = buddyMovingState;
                        }
                    }
                }
            } else if (currentState == buddyLeashingState) {
                if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) <= buddyFollowRange)) {
                    UnitIssueOrder(buddyUnit, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
                    currentState = buddyIdleState;
                }
                else {
                    if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) <= buddyFollowRange) && (UnitOrderCount(buddyUnit) == 0)) {
                        if ((UnitOrderCount(activeUnit) == 0)) {
                            currentState = buddyIdleState;
                        }
                        else {
                            UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(activeUnit), 1.0, UnitGetFacing(activeUnit))), c_orderQueueReplace);
                            currentState = buddyLeashingState;
                        }
                    }
                    else {
                        if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) > buddyFollowRange) && (UnitOrderCount(buddyUnit) == 0)) {
                            UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(activeUnit), 1.0, UnitGetFacing(activeUnit))), c_orderQueueReplace);
                            currentState = buddyLeashingState;
                        }
                        else {
                            if ((DistanceBetweenPoints(UnitGetPosition(buddyUnit), OrderGetTargetPoint(UnitOrder(buddyUnit, 0))) <= buddyFollowRange) && (DistanceBetweenPoints(UnitGetPosition(buddyUnit), UnitGetPosition(activeUnit)) > buddyFollowRange)) {
                                UnitIssueOrder(buddyUnit, OrderTargetingPoint(AbilityCommand("move", 0), PointWithOffsetPolar(UnitGetPosition(activeUnit), 1.0, UnitGetFacing(activeUnit))), c_orderQueueReplace);
                                currentState = buddyLeashingState;
                            }
                        }
                    }
                }
            }
        }
        libAffx_Wait(0.0625, c_timeGame);
    }
    libAffx_AddBuddy(ownerPlayer, ownerUnit, -1);
    UnitGroupRemove(libGame_gv_players[ownerPlayer].lv_summonedUnitGroup, buddyUnit);
    UnitKill(buddyUnit);
    UnitBehaviorRemove(ownerUnit, "AffixBuddyDroneOwner", 1);

    return true;
}
bool libAffx_BuddyCheck (bool testConds, bool runActions) {
    unit user = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    int player = EventPlayerEffectUsedUnitOwner(c_effectPlayerCaster);
    int i;
    int totalBuddies = libAffx_CurrentBuddyCount1[player] + libAffx_CurrentBuddyCount2[player] + libAffx_CurrentBuddyCount3[player];
    if (testConds) {
        if (totalBuddies >= libAffx_BuddyCount[player]) {
            return false;
        }
        if (!UnitIsAlive(user)) {
            return false;
        }
    }
    for (i = 1; i <= (libAffx_BuddyCount[player] - totalBuddies); i += 1) {
        totalBuddies = libAffx_CurrentBuddyCount1[player] + libAffx_CurrentBuddyCount2[player] + libAffx_CurrentBuddyCount3[player];
        if (totalBuddies >= libAffx_BuddyCount[player]) {
            break;
        }
        if (UnitGetType(user) == "HeroErik") {
            if (libAffx_CurrentBuddyCount3[player] < libAffx_CurrentBuddyCount1[player] && libAffx_CurrentBuddyCount3[player] < libAffx_CurrentBuddyCount2[player]) {
                UnitCreateEffectUnit(user, "AffixBuddyDroneApplyOwner", user);
            }
        } else if (UnitGetType(user) == "HeroBaleog") {
            if (libAffx_CurrentBuddyCount2[player] < libAffx_CurrentBuddyCount1[player] && libAffx_CurrentBuddyCount2[player] <= libAffx_CurrentBuddyCount3[player]) {
                UnitCreateEffectUnit(user, "AffixBuddyDroneApplyOwner", user);
            }
        } else if (UnitGetType(user) == "HeroOlaf") {
            if (libAffx_CurrentBuddyCount1[player] <= libAffx_CurrentBuddyCount2[player] && libAffx_CurrentBuddyCount1[player] <= libAffx_CurrentBuddyCount3[player]) {
                UnitCreateEffectUnit(user, "AffixBuddyDroneApplyOwner", user);
            }
        } else if (UnitGetType(user) == "RexxarMisha") {
            if (libAffx_CurrentBuddyCount2[player] < libAffx_CurrentBuddyCount1[player]) {
                UnitCreateEffectUnit(user, "AffixBuddyDroneApplyOwner", user);
            }
        } else if (UnitGetType(user) == "HeroRexxar") {
            if (libAffx_CurrentBuddyCount1[player] <= libAffx_CurrentBuddyCount2[player]) {
                UnitCreateEffectUnit(user, "AffixBuddyDroneApplyOwner", user);
            }
        } else {
            UnitCreateEffectUnit(user, "AffixBuddyDroneApplyOwner", user);
        }
        libAffx_Wait(0.0625, c_timeGame);
    }

    return true;
}
bool libAffx_BuddyScaling (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (player > 5 || player < 1) {
            return false;
        }
    }
    if (libAffx_affixes[libAffx_ArmyofBUDDYsIndex].count > 0) {
        libAffx_SetLevelScalingAndValue("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate", player, 0.04, StringToFixed(libAffx_GetCatalogDefaultValue("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate")) * 0.75);
        libAffx_SetLevelScalingAndValue("Effect,AffixBuddyDroneMissileDamage,Amount", player, 0.04, StringToFixed(libAffx_GetCatalogDefaultValue("Effect,AffixBuddyDroneMissileDamage,Amount")) * 0.75);
    } else {
        libAffx_SetDefaultLevelScaling("Effect,AffixBuddyHealCreateHealer,RechargeVitalRate", player);
        libAffx_SetDefaultLevelScaling("Effect,AffixBuddyDroneMissileDamage,Amount", player);
    }

    return true;
}
bool libAffx_BuddyAffixAdded (bool testConds, bool runActions) {
    int count = libAffx_EventAffixCount();
    libAffx_CatalogModifyForAllPlayers("Behavior,AffixBuddyDroneController,Period", FixedToString(4 - (count - 1), 2));
    libAffx_CatalogModifyForAllPlayers("Effect,AffixBuddyHealCreatePersistent,PeriodicPeriodArray[0]", FixedToString(3 - 0.25 * (count - 1), 2));
    return true;
}
bool libAffx_BuddyOncePerGame (bool testConds, bool runActions) {
    int i;
    for (i = 1; i <= 5; i += 1) {
        if (libAffx_playersHeroIndex[i] == libCore_gf_GetIndexFromHero("LostVikings")) {
            libAffx_BuddyCount[i] = 3;
        } else if (libAffx_playersHeroIndex[i] == libCore_gf_GetIndexFromHero("Rexxar")) {
            libAffx_BuddyCount[i] = 2;
        } else {
            libAffx_BuddyCount[i] = 1;
        }
    }
    libAffx_AddPlayerBehaviorWithExclusion(libAffx_player, "AffixBuddyDroneSpawnBehavior", 1, true, "HeroDVaMech");
    return true;
}
