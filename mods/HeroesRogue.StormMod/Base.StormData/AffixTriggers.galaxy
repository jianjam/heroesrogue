bool libAffx_PossessionOncePerGame (bool testConds, bool runActions) {
    libAffx_CopyFilter(libAffx_filterEnemyMinions, libAffx_filterPossession);
    libAffx_AddRequiredUnitTypeFilter(libAffx_filterPossession, "WizardMinion");

    libAffx_AddUnitBehaviorToAllFilter("AffixPossessionController", 1, libAffx_filterPossession);
    return true;
}
bool libAffx_PossessionUnitCreated (bool testConds, bool runActions) {
    unit eventUnit = EventUnitCreatedUnit();
    libAffx_AddUnitBehaviorFilter(eventUnit, "AffixPossessionController", 1, libAffx_filterPossession);
    return true;
}
bool libAffx_PossessionUCO (bool testConds, bool runActions) {
    unit eventUnit = EventUnit();
    libAffx_UpdateUnitBehaviorFilter(eventUnit, "AffixPossessionController", 1, libAffx_filterPossession);
    return true;
}
// ============================================================
// Memory Shortage
// ============================================================
bool libAffx_MemoryShortage (bool testConds, bool runActions) {
    int affix = libAffx_EventAffix();
    int amount = libAffx_affixes[affix].count;
    int difficulty;
    int i;
    
    if (amount == 1) {
        difficulty = libAIAI_ge_HeroAIDifficulty_HeroAIVeryHard;
    } else if (amount == 2) {
        difficulty = libAIAI_ge_HeroAIDifficulty_HeroAIMedium;
    } else if (amount == 3) {
        difficulty = libAIAI_ge_HeroAIDifficulty_HeroAIEasy;
    } else if (amount == 4) {
        difficulty = libAIAI_ge_HeroAIDifficulty_HeroAIVeryEasy;
    } else {
        difficulty = libAIAI_ge_HeroAIDifficulty_HeroAIElite;
    }
    libAffx_Wait(1.25, c_timeGame);
    for (i = 2; i <= 5; i += 1) {
        libAIAI_gf_HeroAISetAIDifficultyLevel(i, difficulty);
        UnitIssueOrder(libAIAI_gv_aIHeroes[i].lv_currentHeroUnit, Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
        AIEnableForPlayer(i, (libAIAI_gv_aIHeroes[i].lv_difficulty));
        DialogControlHookupStandard(c_triggerControlTypeLabel, ("UIContainer/FullscreenUpperContainer/HeroLeaderPanel/HeroLeaderPanelContainer/TabControl/PlayerFrame" + IntToString(i - 1) + "/PlayerNameFrame/PlayerNameLabel"));
        libNtve_gf_SetDialogItemText(DialogControlLastCreated(), StringToText("AI - ") + libAIAI_gf_HeroAIDifficultyDisplayText(i), PlayerGroupAll());
    }

    return true;
}
// ============================================================
// No Fountain
// ============================================================
bool libAffx_NoFountain (bool testConds, bool runActions) {
    unitgroup unitGroup = UnitGroup(null, libAffx_teamOrder, RegionEntireMap(), libCore_gv_filtersStructure, 0);
    int i = UnitGroupCount(unitGroup, c_unitCountAll);
    unit unitvar;
    for (;; i -= 1) {
        unitvar = UnitGroupUnitFromEnd(unitGroup, i);
        if (unitvar == null) { break; }
        if (UnitGetType(unitvar) == "TownMoonwellL3" || UnitGetType(unitvar) == "TownMoonwellL2" || UnitGetType(unitvar) == "TownMoonwell") {
            UnitKill(unitvar);
        }
    }
    return true;
}
// ============================================================
// Bad Bargain
// ============================================================
bool libAffx_BadBargainAffixAdded (bool testConds, bool runActions) {
    libAffx_BagBargainIndex = libAffx_EventAffix();
    libAffx_BadBargainCurrentModifier = libAffx_BadBargainModifier * libAffx_EventAffixCount();
    return true;
}
bool libAffx_BadBargainUnitDied (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    int deadPlayer = UnitGetOwner(deadUnit);
    fixed deathDuration;
    if (testConds) {
        if (libGame_gv_gameOver) {
            return false;
        }
        if (!(deadPlayer >= 1)) {
            return false;
        }
        if (!(deadPlayer <= 5)) {
            return false;
        }
        if (UnitTestState(deadUnit, c_unitStateHallucination)) {
            return false;
        }
        if (libAffx_BagBargainIndex == 0) {
            return false;
        }
        if (libAffx_ResurgenceoftheStormIndex != 0 && libAffx_affixes[libAffx_ResurgenceoftheStormIndex].cooldown <= 0) {
            return false;
        }
        if (UnitGetType(deadUnit) != "RexxarMisha") {
            return false;
        }
    }
    deathDuration = TimerGetRemaining(libGDHL_gv_mishaDeathTimer[deadPlayer]);
    libNtve_gf_StopTimer(libGDHL_gv_mishaDeathTimer[deadPlayer]);
    TimerStart(libGDHL_gv_mishaDeathTimer[deadPlayer], deathDuration * (1 + libAffx_BadBargainCurrentModifier), false, c_timeGame);
    UnitBehaviorSetDuration(libGame_gv_players[deadPlayer].lv_heroUnit, "RexxarSpiritBondCooldown", deathDuration * (1 + libAffx_BadBargainCurrentModifier));
    UnitModifyCooldown(libGame_gv_players[deadPlayer].lv_heroUnit, "Abil/RexxarMishaFocus", deathDuration * (1 + libAffx_BadBargainCurrentModifier), c_cooldownOperationSet);
    return true;
}
bool libAffx_BadBargainHeroKilled (bool testConds, bool runActions) {
    unit deadUnit = libGame_gf_HeroKilledUnit();
    int deadPlayer = libGame_gf_HeroKilledPlayer();
    int killingPlayer = libGame_gf_HeroKilledKillingPlayer();
    fixed deathTime;
    fixed deathDuration;
    // Conditions
    if (testConds) {
        if (libGame_gv_gameOver) {
            return false;
        }
        if (!(deadPlayer >= 1)) {
            return false;
        }
        if (!(deadPlayer <= 5)) {
            return false;
        }
        if (deadUnit != libGame_gv_players[deadPlayer].lv_heroUnit && UnitGetType(libGame_gv_players[deadPlayer].lv_heroUnit) != "HeroLostVikingsController") {
            return false;
        }
        if (UnitTestState(deadUnit, c_unitStateHallucination)) {
            return false;
        }
        if (libAffx_BagBargainIndex == 0) {
            return false;
        }
        if (libGame_diabloUsedSouls[deadPlayer]) {
            return false;
        }
        if (libAffx_ResurgenceoftheStormIndex != 0 && libAffx_affixes[libAffx_ResurgenceoftheStormIndex].cooldown <= 0) {
            return false;
        }
    }
    if (UnitGetType(deadUnit) == "HeroMurky" && !((UnitIsAlive(libGame_gv_heroDeathMurkyRespawnEggs[deadPlayer]) == false) || (libGame_gv_heroDeathMurkyRespawnEggs[deadPlayer] == null))) {
        deathTime = libCore_gv_bALMurkyWithEggDeathTime * (1 + libAffx_BadBargainCurrentModifier);
    } else {
        deathTime = libCore_gf_HeroDeathTime(deadPlayer, UnitLevel(libGame_gv_players[deadPlayer].lv_heroUnit)) * (1 + libAffx_BadBargainCurrentModifier);
    }
    if (UnitGetType(deadUnit) == "HeroLeoric") {
        libGame_gf_HeroDeathStartRespawnTimer(deadPlayer, deathTime);
        libNtve_gf_SendActorMessageToUnit(deadUnit, "SetShowStatusBar 1");
        if ((TimerGetDuration(libGame_gv_players[deadPlayer].lv_respawnTimer) > 0.0)) {
            UnitBehaviorSetDuration(deadUnit, "LeoricUndying", TimerGetRemaining(libGame_gv_players[deadPlayer].lv_respawnTimer));
            UnitBehaviorSetDuration(deadUnit, "Dead", TimerGetRemaining(libGame_gv_players[deadPlayer].lv_respawnTimer));
            libGDHL_gv_hero_Leoric_Undying_Dead_Duration[deadPlayer] = UnitBehaviorDurationTotal(deadUnit, "LeoricUndying");
        }
        else {
            UnitBehaviorSetDuration(deadUnit, "LeoricUndying", 0.0);
            UnitBehaviorSetDuration(deadUnit, "Dead", 0.0);
            libGDHL_gv_hero_Leoric_Undying_Dead_Duration[deadPlayer] = UnitBehaviorDurationTotal(deadUnit, "LeoricUndying");
        }
        CatalogFieldValueSetFixed(c_gameCatalogEffect, "LeoricUndyingLifeRegenModifyUnit", "VitalArray[" + IntToString(0) + "].ChangeFraction", deadPlayer, (0.5 / (libGDHL_gv_hero_Leoric_Undying_Dead_Duration[deadPlayer] - 2.0)));
    } else if (UnitGetType(deadUnit) == "HeroOlaf") {
        TimerStart(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_olafDeathTimer, TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_olafDeathTimer) * (1 + libAffx_BadBargainCurrentModifier), false, c_timeGame);
    } else if (UnitGetType(deadUnit) == "HeroBaleog") {
        TimerStart(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_baleogDeathTimer, TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_baleogDeathTimer) * (1 + libAffx_BadBargainCurrentModifier), false, c_timeGame);
    } else if (UnitGetType(deadUnit) == "HeroErik") {
        TimerStart(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_erikDeathTimer, TimerGetRemaining(libGDHL_gv_lostVikingsPlayer[deadPlayer].lv_erikDeathTimer) * (1 + libAffx_BadBargainCurrentModifier), false, c_timeGame);
    } else {
        libGame_gf_HeroDeathStartRespawnTimer(deadPlayer, deathTime);
        libGame_gf_HeroDeathUpdateUIElementsForDeath(true, true, true, deadPlayer, killingPlayer);
        libGame_gf_HeroDeathEnableDisableDeadSoundStateForPlayer(true, deadPlayer);
        libGame_gf_HeroDeathPortHeroBackAndSetDeathState(deadPlayer, libGame_gv_players[deadPlayer].lv_spawnPoint);
    }
    return true;
}
