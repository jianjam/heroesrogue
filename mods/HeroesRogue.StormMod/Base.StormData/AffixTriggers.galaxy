// Very Bad Bargain
// ============================================================
bool libAffx_VeryBadBargainAffixAdded (bool testConds, bool runActions) {
    libAffx_VeryBadBargainIndex = libAffx_EventAffix();
    return true;
}
bool libAffx_VeryBadBargainOncePerGame (bool testConds, bool runActions) {
    libAffx_Wait(0.0625, c_timeGame);
    if (testConds) {
        if (libAffx_VeryBadBargainIndex == 0) {
            return false;
        }
    }
    libAffx_affixes[libAffx_VeryBadBargainIndex].cooldown = libAffx_VeryBadBargainCooldown;
    return true;
}
bool libAffx_VeryBadBargainPeriodic (bool testConds, bool runActions) {
    if (testConds) {
        if (libAffx_VeryBadBargainIndex == 0) {
            return false;
        }
        if (libAffx_gamePaused) {
            return false;
        }
        if (!libAffx_GateIsOpen()) {
            return false;
        }
    }

    if (libAffx_affixes[libAffx_VeryBadBargainIndex].cooldown <= 0) {
        libAffx_CatalogReferenceModify("Behavior,VeryBadBargainDebuff,Modification.HealDealtAdditiveMultiplier[Life]", libAffx_player, FixedToString(libAffx_VeryBadBargainModifier * libAffx_affixes[libAffx_VeryBadBargainIndex].count, 2), c_upgradeOperationSubtract);
        libAffx_CatalogReferenceModify("Behavior,VeryBadBargainDebuff,Modification.HealDealtAdditiveMultiplier[Shields]", libAffx_player, FixedToString(libAffx_VeryBadBargainModifier * libAffx_affixes[libAffx_VeryBadBargainIndex].count, 2), c_upgradeOperationSubtract);
        libAffx_CatalogReferenceModify("Behavior,VeryBadBargainDebuff,Modification.DamageDealtFraction[Ability]", libAffx_player, FixedToString(libAffx_VeryBadBargainModifier * libAffx_affixes[libAffx_VeryBadBargainIndex].count, 2), c_upgradeOperationSubtract);
        libAffx_CatalogReferenceModify("Behavior,VeryBadBargainDebuff,Modification.DamageDealtFraction[Basic]", libAffx_player, FixedToString(libAffx_VeryBadBargainModifier * libAffx_affixes[libAffx_VeryBadBargainIndex].count, 2), c_upgradeOperationSubtract);
        libAffx_affixes[libAffx_VeryBadBargainIndex].cooldown = libAffx_VeryBadBargainCooldown;
    } else {
        libAffx_affixes[libAffx_VeryBadBargainIndex].cooldown -= 0.0625;
    }

    return true;
}
// ============================================================
// Purification Protocol
// ============================================================
void libAffx_AffixPurificationProtocolCastBeam() {
    unit casterUnit = libGame_gv_teams[libAffx_teamChaosIndex].lv_core;
    unitgroup heroGroup = libGame_gv_players[libAffx_player].lv_heroUnitGroup;
    int groupCount = UnitGroupCount(heroGroup, c_unitCountAll);
    unit heroUnit;
    unit beamUnit;
    bool applied;
    
    while (!applied) {
        for (;; groupCount -= 1) {
            if (groupCount <= 0) { break; }
            heroUnit = UnitGroupUnitFromEnd(heroGroup, groupCount);
            if (UnitGetType(heroUnit) == "HeroLostVikingsController") { continue; }
            
            while (!UnitIsAlive(heroUnit) || UnitHasBehavior2(heroUnit, "HallOfStormsProtectionBuff")) {
                libAffx_Wait(0.0625, c_timeGame);
            }
    
            libAffx_PurificationProtocolTargetUnit = heroUnit;
            UnitCreateEffectUnit(casterUnit, "ArtanisSpearofAdunPurifierBeamInitialSet", libAffx_PurificationProtocolTargetUnit);
            UnitBehaviorAdd(heroUnit, "PurificationProtocol", heroUnit, 1);
            beamUnit = UnitGroupUnit(UnitGroup("ArtanisSpearofAdunPurifierBeamInvisibleTrackingUnit", UnitGetOwner(casterUnit), RegionEntireMap(), null, 0), 1);
            libNtve_gf_SendActorMessageToUnit(beamUnit, "SetMinimapVisibility 1");
            libNtve_gf_SendActorMessageToUnit(beamUnit, "SetMinimapVisibilityAlways 1");
            libNtve_gf_SendActorMessageToUnit(beamUnit, "MinimapIcon Assets/Textures/affix_minimap_icon_red_circle.dds");
            libNtve_gf_SendActorMessageToUnit(beamUnit, "MinimapIconScale 0.4");
            applied = true;
            break;
        }
        libAffx_Wait(0.25, c_timeGame);
    }
}
bool libAffx_PurificationProtocolOncePerGame (bool testConds, bool runActions) {
    TriggerEnable(libGDHL_gt_HeroArtanisSpearofAdunPurifierBeamSetTarget, true);
    TriggerEnable(libGDHL_gt_HeroArtanisSpearofAdunPurifierBeamRedirectTarget2ElectricBoogaloo, true);
    TriggerEnable(libGDHL_gt_HeroArtanisSpearofAdunPurifierBeamUnitCreated, true);
    libGame_AddAbilityEffectMapping("ArtanisSpearofAdunPurifierBeam", "ArtanisSpearofAdunPurifierBeamDamage");
    libAffx_CatalogReferenceSet("Behavior,ArtanisSpearofAdunPurifierBeamTimedLife,Duration", libAffx_teamChaos, "0");
    libAffx_CatalogReferenceSet("Behavior,ArtanisSpearofAdunPurifierBeamRevealer,Duration", libAffx_teamChaos, "1");
    libAffx_CatalogReferenceSet("Behavior,ArtanisSpearofAdunPurifierBeamPointMovementOverride,Duration", libAffx_teamChaos, "0");
    libAffx_CatalogReferenceSet("Behavior,ArtanisSpearofAdunPurifierBeamMoveSearch,Duration", libAffx_teamChaos, "0");
    while (!libAffx_GateIsOpen()) {
        libAffx_Wait(0.0625, c_timeGame);
    }
    libAffx_AffixPurificationProtocolCastBeam();
    return true;
}
bool libAffx_PurificationProtocolLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player != libAffx_enemy) {
            return false;
        }
    }
    libAffx_SetDefaultLevelScaling("Effect,ArtanisSpearofAdunPurifierBeamDamage,Amount", libAffx_teamChaos);
    
    return true;
}
