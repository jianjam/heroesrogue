// ============================================================
// MacGuffin
// ============================================================
bool libAffx_MacGuffinAffixAdded (bool testConds, bool runActions) {
    int i;
    fixed original = StringToFixed(CatalogReferenceGet("Effect,CaptureMacGuffin,PeriodCount", 0));
    fixed originalVehicle = StringToFixed(CatalogReferenceGet("Effect,UseVehiclePersistent,PeriodCount", 0));

    libAffx_MacGuffinCurrentModifier = libAffx_MacGuffinModifier + (libAffx_MacGuffinModifierPerStack * (libAffx_EventAffixCount() - 1));

    for (i = 1; i <= 5; i += 1) {
        libAffx_CatalogReferenceModify("Effect,CaptureMacGuffin,PeriodCount", i, FixedToString(original * (1 - libAffx_MacGuffinCurrentModifier), 0), c_upgradeOperationSet);
        libAffx_CatalogReferenceModify("Effect,UseVehiclePersistent,PeriodCount", i, FixedToString(originalVehicle * (1 - libAffx_MacGuffinCurrentModifier), 0), c_upgradeOperationSet);
    }

    return true;
}
//--------------------------------------------------------------------------------------------------
// Crash Stress
//--------------------------------------------------------------------------------------------------
bool libAffx_CrashStressUnitDied (bool testConds, bool runActions) {
    unit deadUnit = EventUnit();
    int deadPlayer = EventPlayer();
    unit dvaUnit = libGame_gv_players[deadPlayer].lv_heroUnit;
    soundlink soundLink = SoundLink("DVaCrashStressSound", -1);
    sound hSound;

    if (testConds) {
        if (deadPlayer != libAffx_player) {
            return false;
        }
		if (UnitGetType(libGame_gv_players[deadPlayer].lv_heroUnit) != "HeroDVaPilot") {
            return false;
		}
        if (deadUnit == libGame_gv_players[deadPlayer].lv_heroUnit) {
			return false;
        }
        if (UnitTestState(deadUnit, c_unitStateHallucination)) {
            return false;
        }
    }

    UnitBehaviorAdd(dvaUnit, "AffixCrashStressBehavior", dvaUnit, 1);
    libAffx_MuteAllChannelsExcept(PlayerGroupAll(), true, c_soundCategoryTV);
    SoundPlay(soundLink, PlayerGroupAll(), 200, 0.0);
    hSound = SoundLastPlayed();
    SoundWait(hSound, 5.0, 0);
    libAffx_MuteAllChannelsExcept(PlayerGroupAll(), false, c_soundCategoryTV);

	return true;
}
