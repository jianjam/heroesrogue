// ============================================================
void libAffx_UpdatePathoftheWizard(int player) {
    int level = UnitLevel(libGame_gv_players[player].lv_heroUnit);
    if (libAffx_PathoftheWizardIndex == 0) {
        return;
    }
    libAffx_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixPathoftheWizardBehavior", "Modification.VitalRegenArray[Energy]", player, 0.2 * libAffx_affixes[libAffx_PathoftheWizardIndex].count * (level + libAffx_PathoftheFighterBonus));
    libAffx_CatalogFieldValueSetFixed(c_gameCatalogBehavior, "AffixPathoftheWizardBehavior", "Modification.VitalMaxArray[Energy]", player, 10 * libAffx_affixes[libAffx_PathoftheWizardIndex].count * (level + libAffx_PathoftheFighterBonus));
}
bool libAffx_PathoftheWizardAffixAdded (bool testConds, bool runActions) {
    int i;
    libAffx_PathoftheWizardIndex = libAffx_EventAffix();
    for (i = 1; i <= libCore_gv_bALMaxPlayers; i += 1) {
        libAffx_UpdatePathoftheWizard(i);
    }
    return true;
}

bool libAffx_PathoftheWizardLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    if (testConds) {
        if (!UnitHasBehavior2(libGame_gv_players[player].lv_heroUnit, "AffixPathoftheWizardBehavior")) {
            return false;
        }
        if (libAffx_PathoftheWizardIndex == 0) {
            return false;
        }
    }
    libAffx_UpdatePathoftheWizard(player);
    return true;
}
