// ============================================================
// Talent Disadvantage
// ============================================================

void libAffx_ApplyTalentDisadvantage(int player, int level) {
    string hero = libCore_gf_GetHeroFromIndex(libAffx_playersHeroIndex[player]);
    int stacks = libAffx_affixes[libAffx_TalentDisadvantageIndex].count;
    int levelChromie;
    if (hero == "Chromie") {
        levelChromie = 2;
    }
    if (hero == "Varian") {
        if (stacks >= 1 && level < 7) {
            libAffx_SelectAllTalents(player, level, true);
        }
        if (stacks >= 2 && level < 10) {
            libAffx_SelectAllTalents(player, level, true);
        }
        if (stacks >= 3 && level < 13) {
            libAffx_SelectAllTalents(player, level, true);
        }
        if (stacks >= 4 && level < 16) {
            libAffx_SelectAllTalents(player, level, true);
        }
        if (stacks >= 5 && level < 20) {
            libAffx_SelectAllTalents(player, level, true);
        }
        if (stacks >= 6) {
            libAffx_SelectAllTalents(player, level, true);
        }
    } else {
        if (stacks >= 1 && (level + levelChromie) < 4) {
            libAffx_SelectAllTalents(player, level, true);
        }
        if (stacks >= 2 && (level + levelChromie) < 7) {
            libAffx_SelectAllTalents(player, level, true);
        }
        if (stacks >= 3 && (level + levelChromie) < 13) {
            libAffx_SelectAllTalents(player, level, true);
        }
        if (stacks >= 4 && (level + levelChromie) < 16) {
            libAffx_SelectAllTalents(player, level, true);
        }
        if (stacks >= 5 && (level + levelChromie) < 20) {
            libAffx_SelectAllTalents(player, level, true);
        }
        if (stacks >= 6) {
            libAffx_SelectAllTalents(player, level, true);
        }
    }
}
bool libAffx_TalentDisadvantageAffixAdded (bool testConds, bool runActions) {
    int i;
    libAffx_TalentDisadvantageIndex = libAffx_EventAffix();
    for (i = 6; i <= 10; i += 1) {
        libAffx_ApplyTalentDisadvantage(i, UnitLevel(libGame_gv_players[i].lv_heroUnit));
        libAffx_Wait(0.0625, c_timeGame);
    }
    return true;
}
bool libAffx_TalentDisadvantageLevelUp (bool testConds, bool runActions) {
    int player = libGame_gf_HeroLevelUpPlayer();
    int level = libGame_gf_HeroLevelUpLevel();
    if (testConds) {
        if (player < 6 || player > 10) {
            return false;
        }
        if (libAffx_TalentDisadvantageIndex == 0) {
            return false;
        }
    }
    libAffx_ApplyTalentDisadvantage(player, level);
    return true;
}
